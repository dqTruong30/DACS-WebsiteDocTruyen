@{
    ViewData["Title"] = "Đăng Nhiều Chương Cùng Lúc";
}

<section class="panel">
    <div class="mb-4">
        <div class="section-kicker">Tải lên hàng loạt</div>
        <h1 class="page-title">Đăng Nhiều Chương</h1>
    </div>

    <form asp-area="Admin" asp-controller="QuanLyChuong" asp-action="ThemNhieuChuong" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="maTruyen" value="@ViewBag.MaTruyen" />
        
        <div class="mb-3">
            <label class="fw-bold mb-2">Chọn các file Text (.txt)</label>
            <input type="file" name="textFiles" class="field" accept=".txt" multiple required />
            <small class="text-muted d-block mt-1">Lưu ý: Tên file sẽ được tự động sử dụng làm Tiêu đề chương. Hãy đặt tên file theo thứ tự (VD: 001_Chuong1.txt, 002_Chuong2.txt) để chương được sắp xếp đúng.</small>
        </div>

        <div class="mb-3">
            <label class="fw-bold mb-2">Trạng thái chương</label>
            <select name="trangThai" class="field">
                <option value="@HutechNovel.Models.TrangThaiChuong.DaXuatBan">Đăng ngay</option>
                <option value="@HutechNovel.Models.TrangThaiChuong.BanNhap">Lưu nháp</option>
            </select>
        </div>
        
        <div class="d-flex gap-3">
            <button class="btn-neon" type="submit">
                <i class="fas fa-upload me-2"></i> Tải lên
            </button>
            <a class="btn-ghost" asp-action="DanhSach" asp-route-maTruyen="@ViewBag.MaTruyen">Quay lại</a>
        </div>
    </form>
</section>
