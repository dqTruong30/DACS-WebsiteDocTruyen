@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-main__header">
    <div>
        <div class="section-kicker">Bảo mật tài khoản</div>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="manage-card">
    <form id="change-password-form" method="post" class="manage-form">
        <div asp-validation-summary="ModelOnly" class="status-banner is-danger"></div>

        <div>
            <label asp-for="Input.OldPassword" class="auth-label">Mật khẩu hiện tại</label>
            <input asp-for="Input.OldPassword" class="field" placeholder="Nhập mật khẩu cũ" />
            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="Input.NewPassword" class="auth-label">Mật khẩu mới</label>
            <input asp-for="Input.NewPassword" class="field" placeholder="Nhập mật khẩu mới" />
            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="auth-label">Xác nhận mật khẩu mới</label>
            <input asp-for="Input.ConfirmPassword" class="field" placeholder="Nhập lại mật khẩu mới" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn-neon">Cập nhật mật khẩu</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
