@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Thiết lập mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-main__header">
    <div>
        <div class="section-kicker">Bảo mật tài khoản</div>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="manage-card">
    <div class="status-banner is-warning mb-4">
        <div style="font-weight: 700; margin-bottom: 0.3rem;">Tài khoản chưa có mật khẩu cục bộ!</div>
        <div style="font-size: 0.95rem; font-weight: 500;">
            Bạn đang sử dụng tài khoản liên kết (Google). Hãy thiết lập mật khẩu tại đây để có thể đăng nhập trực tiếp bằng Tên đăng nhập/Email mà không cần thông qua liên kết ngoài.
        </div>
    </div>

    <form id="set-password-form" method="post" class="manage-form">
        <div asp-validation-summary="ModelOnly" class="status-banner is-danger"></div>

        <div>
            <label asp-for="Input.NewPassword" class="auth-label">Mật khẩu mới</label>
            <input asp-for="Input.NewPassword" class="field" placeholder="Nhập mật khẩu từ 6 ký tự..." />
            <span asp-validation-for="Input.NewPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="auth-label">Xác nhận mật khẩu</label>
            <input asp-for="Input.ConfirmPassword" class="field" placeholder="Nhập lại mật khẩu vừa tạo..." />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="btn-neon mt-2">Xác nhận thiết lập</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}