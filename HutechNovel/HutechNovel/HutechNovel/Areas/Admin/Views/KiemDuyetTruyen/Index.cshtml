@model IEnumerable<HutechNovel.Models.Truyen>
@using HutechNovel.Models

@{
    ViewData["Title"] = "Kiểm Duyệt Nội Dung Toàn Cầu";

    string StatusText(TrangThaiTruyen status) => status switch
    {
        TrangThaiTruyen.DaHoanThanh => "Đã hoàn thành",
        TrangThaiTruyen.TamNgung => "Tạm ngưng",
        _ => "Đang tiến hành"
    };

}

<section class="panel mb-4" style="border-left: 4px solid var(--public-red);">
    <div class="d-flex align-items-center gap-3">
        
        <div>
            <div class="section-kicker" style="color: var(--public-red);">Command Center</div>
            <h1 class="page-title text-uppercase" style="margin:0; text-shadow: 0 0 10px rgba(255, 61, 110, 0.3);">Kiểm Duyệt Truyện</h1>
        </div>
    </div>
    <div class="admin-toolbar mt-4">
        <input class="inline-input w-100" type="text" id="liveSearchKiemDuyet" placeholder="Nhập tên truyện hoặc tên Uploader để lọc ngay lập tức..." autocomplete="off" />
    </div>
    <div class="mt-3 muted">Đang hiển thị: <span id="storyCount" style="font-weight: 800; color: var(--public-text);">@Model.Count()</span> đầu truyện trên toàn hệ thống</div>
</section>

<section class="table-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th style="width: 30%;">Tên Truyện</th>
                <th style="width: 15%;">Người Đăng (Uploader)</th>
                <th style="width: 15%;">Tác Giả</th>
                <th style="width: 15%;">Trạng Thái</th>
                <th style="width: 25%; text-align: center;">Hành động (Ghi đè)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="searchable-story">
                    <td class="search-title">
                        <strong style="font-size: 1.05rem; color: var(--public-text);">@item.TieuDe</strong>
                        <div class="mini-note mt-1">Cập nhật: @item.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</div>
                    </td>
                    <td class="search-uploader">
                        <span class="role-chip">
                            @item.NguoiDang?.UserName
                        </span>
                    </td>
                    <td>@item.TacGia?.TenTacGia</td>
                    <td>
                        <form asp-area="Admin" asp-controller="KiemDuyetTruyen" asp-action="DoiTrangThai" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MaTruyen" />
                            <select name="trangThaiMoi" class="field-select" style="padding: 0.4rem; font-size: 0.85rem;" onchange="this.form.submit()">
                                @foreach (var status in Enum.GetValues(typeof(TrangThaiTruyen)))
                                {
                                    if ((TrangThaiTruyen)status == item.TrangThai)
                                    {
                                        <option value="@status" selected>@StatusText((TrangThaiTruyen)status)</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@StatusText((TrangThaiTruyen)status)</option>
                                    }
                                }
                            </select>
                        </form>
                    </td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a class="btn-action btn-view" asp-area="" asp-controller="Truyen" asp-action="ChiTiet" asp-route-id="@item.MaTruyen" target="_blank" title="Xem truyện public">
                                Xem
                            </a>
                            
                            <button type="button" class="btn-action btn-delete btn-cyber-danger"
                                    data-bs-toggle="modal" data-bs-target="#forceDeleteModal"
                                    data-id="@item.MaTruyen" data-title="@item.TieuDe">
                                FORCE DELETE
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

<div class="modal fade" id="forceDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--public-surface); border: 1px solid var(--public-border); border-radius: var(--radius-lg); color: var(--public-text);">
            <div class="modal-body text-center py-5 px-4">
                <div style="font-size: 4rem; line-height: 1; color: var(--public-red); margin-bottom: 1.5rem; text-shadow: 0 0 15px rgba(255, 61, 110, 0.4);">
                    ☢️
                </div>
                <h4 style="font-weight: 800; margin-bottom: 0.5rem; color: var(--public-red);">XÓA CƯỠNG CHẾ?</h4>
                <strong id="deleteStoryTitle" style="font-size: 1.3rem; display: block; margin-bottom: 1rem;"></strong>
                <p class="muted mb-4" style="font-size: 0.95rem;">
                    Lệnh xóa từ Admin sẽ tiêu hủy toàn bộ dữ liệu truyện bất chấp quyền sở hữu của Uploader.
                    <br /><b>Quyết định này là tuyệt đối và không thể hoàn tác!</b>
                </p>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal" style="min-width: 120px;">Hủy bỏ</button>
                    <form asp-area="Admin" asp-controller="QuanLyTruyen" asp-action="Xoa" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteStoryId" value="" />
                        <button type="submit" class="btn-cyber-danger" style="padding: 0.65rem 1rem; border-radius: 10px; font-weight: 700; min-width: 120px;">
                            XÁC NHẬN TIÊU HỦY
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Modal Logic
            var deleteModal = document.getElementById('forceDeleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function(event) {
                    var button = event.relatedTarget;
                    var storyId = button.getAttribute('data-id');
                    var storyTitle = button.getAttribute('data-title');
                    
                    deleteModal.querySelector('#deleteStoryTitle').textContent = '"' + storyTitle + '"';
                    deleteModal.querySelector('#deleteStoryId').value = storyId;
                });
            }

            // JavaScript Real-time Search Logic
            var searchInput = document.getElementById('liveSearchKiemDuyet');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    let keyword = e.target.value.toLowerCase().trim();
                    let rows = document.querySelectorAll('.searchable-story');
                    let visibleCount = 0;

                    rows.forEach(row => {
                        let title = row.querySelector('.search-title').innerText.toLowerCase();
                        let uploader = row.querySelector('.search-uploader').innerText.toLowerCase();
                        
                        // Tìm thấy keyword trong tên truyện hoặc tên người đăng
                        if (title.includes(keyword) || uploader.includes(keyword)) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    // Cập nhật số lượng đếm được ngay trên UI
                    document.getElementById('storyCount').textContent = visibleCount;
                });
            }
        });
    </script>
}
