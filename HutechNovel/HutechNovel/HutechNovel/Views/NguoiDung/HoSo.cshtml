@model HutechNovel.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Hồ Sơ";
}

<section class="library-layout">
    <div class="panel">
        <div class="section-kicker">Hồ sơ & nhiệm vụ</div>
        <h1 class="page-title">@(!string.IsNullOrWhiteSpace(Model.User.HoTen) ? Model.User.HoTen : Model.User.UserName)</h1>
        <div class="muted mb-4">@Model.User.Email</div>
        <div class="stats-grid-4">
            <div class="stats-card">
                <div class="muted">Vé đẩy sách</div>
                <strong>@Model.User.VeDaySach</strong>
            </div>
            <div class="stats-card">
                <div class="muted">Truyện đã đọc</div>
                <strong>@Model.ReadStoryCount</strong>
            </div>
            <div class="stats-card">
                <div class="muted">Theo dõi</div>
                <strong>@Model.FollowingCount</strong>
            </div>
            <div class="stats-card">
                <div class="muted">Đọc sau</div>
                <strong>@Model.BookmarkCount</strong>
            </div>
        </div>
        <form asp-action="DiemDanh" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <button class="btn-neon" type="submit">Điểm danh nhận thưởng</button>
        </form>
        @if (TempData["Success"] != null)
        {
            <div class="mt-3 text-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mt-3 text-danger">@TempData["Error"]</div>
        }
    </div>

    <aside class="panel">
        <h2 class="section-title mb-3">Nhiệm vụ hôm nay</h2>
        <ul class="simple-list">
            <li class="simple-item"><strong>Điểm danh</strong><span>+1 vé đẩy sách</span></li>
            <li class="simple-item"><strong>Đọc truyện 30 phút</strong><span>Sẵn sàng gắn chức năng</span></li>
            <li class="simple-item"><strong>Bình luận hợp lệ</strong><span>Khuyến khích tương tác</span></li>
        </ul>
    </aside>
</section>
