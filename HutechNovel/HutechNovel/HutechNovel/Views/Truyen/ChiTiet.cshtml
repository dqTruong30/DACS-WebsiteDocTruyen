@model HutechNovel.Models.StoryDetailViewModel
@using HutechNovel.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUserId = UserManager.GetUserId(User);
    var isAdmin = User.IsInRole("Admin");
    var canManageComments = isAdmin || (!string.IsNullOrWhiteSpace(currentUserId) && Model.Truyen.NguoiDangId == currentUserId);
}
<style>
    /* Làm xám toàn bộ chữ của chương đã đọc */
    .chapter-item.is-read a {
        color: var(--public-muted) !important;
        font-weight: 400; /* Bỏ in đậm nếu muốn nhìn chìm hơn */
    }

    .chapter-item.is-read {
        opacity: 0.6; /* Làm mờ cả dòng */
    }

    .rating-login-box {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        padding: 0.85rem 1rem;
        border: 1px dashed var(--public-border);
        border-radius: var(--radius-md);
        background: var(--public-surface-2);
    }

    .boost-box {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.85rem;
        align-items: center;
        padding: 0.85rem 1rem;
        border: 1px solid var(--public-border);
        border-radius: var(--radius-md);
        background: var(--public-surface-2);
    }

    .boost-form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: center;
    }

    .boost-input {
        width: 88px;
        text-align: center;
    }

    .comment-toolbar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: center;
        margin-top: 1.4rem;
        margin-bottom: 1rem;
    }

    .comment-sort-tabs {
        display: inline-flex;
        gap: 0.35rem;
        padding: 0.2rem;
        border: 1px solid var(--public-border);
        border-radius: 999px;
        background: var(--public-surface-2);
    }

    .comment-sort-tabs a {
        color: var(--public-muted);
        font-weight: 800;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        text-decoration: none;
    }

    .comment-sort-tabs a.is-active {
        color: var(--public-green);
        background: rgba(34, 255, 102, 0.1);
    }

    .comment-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--public-green);
        font-size: 0.78rem;
        font-weight: 900;
        margin-left: 0.5rem;
    }

    .comment-action-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.6rem;
    }

    .comment-action-btn {
        background: none;
        border: none;
        color: var(--public-muted);
        font-size: 0.82rem;
        font-weight: 800;
        cursor: pointer;
        padding: 0;
    }

    .comment-action-btn:hover {
        color: var(--public-green);
    }

    .comment-action-btn.is-danger:hover {
        color: var(--public-red);
    }

    .comment-action-btn.is-reacted {
        color: var(--public-green);
        opacity: 0.85;
        cursor: default;
    }

    .spoiler-content {
        border: 1px dashed var(--public-border);
        border-radius: var(--radius-md);
        padding: 0.75rem;
        background: var(--public-surface-2);
    }

    .spoiler-content.is-hidden .spoiler-body {
        display: none;
    }

    .spoiler-warning {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        color: var(--public-muted);
        font-weight: 800;
    }
</style>
@{
    ViewData["Title"] = Model.Truyen.TieuDe;

    string StatusText(TrangThaiTruyen status) => status switch
    {
        TrangThaiTruyen.DaHoanThanh => "Đã hoàn thành",
        TrangThaiTruyen.TamNgung => "Tạm ngưng",
        _ => "Đang tiến hành"
    };
}

<section class="panel story-detail-hero mb-4">
    <div class="story-detail-hero__cover">
        <img src="@(string.IsNullOrWhiteSpace(Model.Truyen.AnhBia) ? "https://static.sangtacvietcdn.xyz/img/bookcover256.jpg" : Model.Truyen.AnhBia)"
             alt="@Model.Truyen.TieuDe"
             onerror="this.src='https://static.sangtacvietcdn.xyz/img/bookcover256.jpg';" />
    </div>

    <div class="story-detail-hero__main">
        <div class="story-meta mb-2">
            <span class="status-chip">@StatusText(Model.Truyen.TrangThai)</span>
            @foreach (var tag in Model.Truyen.Thes)
            {
                <span class="meta-tag">@tag.TenThe</span>
            }
        </div>

        <h1 class="page-title">@Model.Truyen.TieuDe</h1>
        <div class="muted mb-3">
            <i class="fas fa-pen-nib me-1"></i>
            @if (Model.Truyen.TacGia != null)
            {
                <a class="author-link" asp-controller="TacGia" asp-action="ChiTiet" asp-route-id="@Model.Truyen.TacGia.MaTacGia">@Model.Truyen.TacGia.TenTacGia</a>
            }
            else
            {
                <span>Đang cập nhật</span>
            }
        </div>

        <div class="stats-grid-4 story-stats">
            <div class="stats-card"><span>Lượt xem</span><strong>@Model.Truyen.TongLuotXem</strong></div>
            <div class="stats-card"><span>Thích</span><strong data-count-for="YeuThich">@Model.TotalLikes</strong></div>
            <div class="stats-card"><span>Đánh dấu</span><strong data-count-for="DanhDau">@Model.TotalBookmarks</strong></div>
            <div class="stats-card"><span>Theo dõi</span><strong data-count-for="TheoDoi">@Model.TotalFollowers</strong></div>
        </div>

        <div class="story-actions mt-4">
            @{
                // Lấy ra chương cuối cùng trong danh sách (đã xếp theo thứ tự) mà nằm trong nhóm "đã đọc"
                var lastReadChapter = Model.Chapters.LastOrDefault(c => Model.ReadChapterIds.Contains(c.MaChuong));
            }

            @if (lastReadChapter != null)
            {
                <!-- NẾU CÓ CHƯƠNG ĐÃ ĐỌC -> HIỂN THỊ NÚT ĐỌC TIẾP -->
                <a class="btn-neon" asp-controller="DocTruyen" asp-action="Index"
                   asp-route-maTruyen="@Model.Truyen.MaTruyen"
                   asp-route-soChuong="@lastReadChapter.SoChuong">
                    <i class="fas fa-book-reader me-2"></i>Đọc tiếp chương @lastReadChapter.SoChuong
                </a>
            }
            else if (Model.FirstPublishedChapter != null)
            {
                <!-- NẾU CHƯA ĐỌC LẦN NÀO -> HIỂN THỊ NÚT ĐỌC TỪ ĐẦU -->
                <a class="btn-neon" asp-controller="DocTruyen" asp-action="Index"
                   asp-route-maTruyen="@Model.Truyen.MaTruyen"
                   asp-route-soChuong="@Model.FirstPublishedChapter.SoChuong">
                    <i class="fas fa-book-open me-2"></i>Đọc từ đầu
                </a>
            }

            <button class="btn-ghost story-action-btn @(Model.IsLiked ? "is-active" : "")" type="button" data-action="YeuThich">
                <i class="far fa-heart me-1"></i>Thích
            </button>
            <button class="btn-ghost story-action-btn @(Model.IsBookmarked ? "is-active" : "")" type="button" data-action="DanhDau">
                <i class="far fa-bookmark me-1"></i>Đánh dấu
            </button>
            <button class="btn-ghost story-action-btn @(Model.IsFollowing ? "is-active" : "")" type="button" data-action="TheoDoi">
                <i class="far fa-bell me-1"></i>Theo dõi
            </button>
        </div>
        <div class="boost-box mt-3">
            <div>
                <div class="fw-bold">Đẩy sách cho truyện này</div>
                <div class="muted small">Mỗi vé cộng 1 lượt đẩy, giúp truyện tăng hạng trong bảng xếp hạng Đẩy sách.</div>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="DayTruyen" asp-action="ThucHienDay" method="post" class="boost-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maTruyen" value="@Model.Truyen.MaTruyen" />
                    <span class="status-chip">@Model.CurrentUserBoostTickets vé hiện có</span>
                    <input class="inline-input boost-input" type="number" name="soLuongVe" min="1" max="@Math.Max(1, Model.CurrentUserBoostTickets)" value="1" @(Model.CurrentUserBoostTickets <= 0 ? "disabled" : "") />
                    <button class="btn-neon" type="submit" @(Model.CurrentUserBoostTickets <= 0 ? "disabled" : "")>
                        <i class="fas fa-rocket me-1"></i>Đẩy sách
                    </button>
                </form>
            }
            else
            {
                <a class="btn-ghost" asp-area="Identity" asp-page="/Account/Login">Đăng nhập để dùng vé</a>
            }
        </div>
    </div>
</section>

<section class="panel mb-4">
    <div class="section-kicker">Tóm tắt</div>
    <h2 class="section-title mb-3">Giới thiệu truyện</h2>
    <div class="story-description">@Model.Truyen.MoTa</div>
</section>

<section class="panel mb-4">
    <div class="chapter-toolbar">
        <div>
            <div class="section-kicker">Danh sách chương</div>
            <h2 class="section-title">@Model.Chapters.Count chương</h2>
        </div>
        <!-- Thêm style="gap: 1px;" và đổi vị trí button lên trước input -->
        <div class="chapter-tools" style="display: flex; gap: 4px; align-items: stretch;">
            <button class="btn-pill d-flex align-items-center justify-content-center" type="button" id="chapterSort" data-sort="asc" title="Đảo thứ tự chương"
                    style="margin: 0; padding: 0; width: 48px; flex-shrink: 0; background: var(--public-surface-2);">
                <i class="fas fa-arrow-down-short-wide"></i>
            </button>
            <input type="text" id="chapterSearch" class="inline-input" placeholder="Tìm chương..."
                   style="margin: 0; padding: 0.65rem 1rem; flex: 1;" />
        </div>
    </div>
    @if (Model.Chapters.Any())
    {
        <!-- THÊM mt-4 vào đây để cách dòng tìm kiếm ra 1 đoạn (margin-top: 1.5rem) -->
        <ul class="chapter-list chapter-list--detail mt-4" id="chapterList">
            @foreach (var chapter in Model.Chapters)
            {
                // KIỂM TRA CHƯƠNG ĐÃ ĐỌC CHƯA
                bool isRead = Model.ReadChapterIds.Contains(chapter.MaChuong);

                // NẾU ĐÃ ĐỌC THÌ GẮN THÊM CLASS 'is-read'
                <li class="chapter-item @(isRead ? "is-read" : "")" data-chapter="@chapter.SoChuong" data-title="@chapter.TieuDe.ToLowerInvariant()">
                    <a asp-controller="DocTruyen" asp-action="Index"
                       asp-route-maTruyen="@Model.Truyen.MaTruyen"
                       asp-route-soChuong="@chapter.SoChuong">
                        Chương @chapter.SoChuong: @chapter.TieuDe
                    </a>
                    <span class="muted small">@chapter.NgayTao.ToString("dd/MM/yyyy")</span>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="empty-box">Truyện chưa có chương được xuất bản.</div>
    }
</section>

<section class="panel">
    <div class="section-kicker">Đánh giá và bình luận</div>
    <h2 class="section-title mb-3">Cảm nhận của độc giả</h2>
    <div class="rating-summary mb-3">
        <span class="text-warning" id="ratingAverage"><i class="fas fa-star"></i> @Model.AverageRating.ToString("0.0")/5.0</span>
        <span class="muted" id="ratingTotal">(@Model.TotalRatings đánh giá)</span>
    </div>

    <!-- KHUNG ĐÁNH GIÁ SAO -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="rating-stars mb-4" id="ratingStars" data-user-rating="@Model.UserRating">
            <span class="muted me-2">Đánh giá của bạn:</span>
            @for (int i = 1; i <= 5; i++)
            {
                <i class="fas fa-star fa-lg" data-value="@i" style="cursor: pointer; color: @(i <= Model.UserRating ? "#ffc107" : "#ccc");" title="@i sao"></i>
            }
        </div>
    }
    else
    {
        <div class="rating-login-box mb-4">
            <span class="muted me-2">Bạn cần đăng nhập để đánh giá truyện.</span>
            <a class="btn-ghost py-1 px-3" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        </div>
    }

    <!-- KHUNG NHẬP BÌNH LUẬN GỐC (Nằm ở trên cùng) -->
    <div class="comment-box pt-0 mt-0 border-0">
        <textarea id="txtBinhLuanGoc" class="field-textarea w-100" rows="3" placeholder="Viết cảm nhận của bạn về truyện này..."></textarea>
        <div class="d-flex justify-content-between align-items-center gap-3 mt-2">
            <label class="muted small fw-bold d-inline-flex align-items-center gap-2" style="cursor: pointer;">
                <input id="chkSpoilerGoc" type="checkbox" />
                Ẩn spoiler
            </label>
            <button id="btnGuiBinhLuanGoc" class="btn-neon py-1 px-3" type="button">Đăng bình luận</button>
        </div>
    </div>

    <!-- DANH SÁCH BÌNH LUẬN PHÂN CẤP -->
    <div class="comment-toolbar">
        <div class="muted fw-bold">@Model.Comments.Count bình luận</div>
        <div class="comment-sort-tabs" aria-label="Sắp xếp bình luận">
            <a class="@(Model.CommentSort == "highlight" ? "is-active" : "")"
               asp-action="ChiTiet"
               asp-route-id="@Model.Truyen.MaTruyen"
               asp-route-commentSort="highlight">Nổi bật</a>
            <a class="@(Model.CommentSort == "latest" ? "is-active" : "")"
               asp-action="ChiTiet"
               asp-route-id="@Model.Truyen.MaTruyen"
               asp-route-commentSort="latest">Mới nhất</a>
        </div>
    </div>

    <div class="comment-list mt-3" id="commentContainer">
        @{
            var parentComments = Model.Comments.Where(c => c.MaBinhLuanCha == null).ToList();
        }

        @for (int i = 0; i < parentComments.Count; i++)
        {
            var comment = parentComments[i];
            var userName = comment.NguoiDung?.UserName ?? "Ẩn danh";
            var avatarUrl = comment.NguoiDung?.Avatar;
            var initial = string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpper();
            var hasReacted = Model.ReactedCommentIds.Contains(comment.MaBinhLuan);

            <div class="comment-thread @(i >= 10 ? "d-none" : "")">
                <!-- BÌNH LUẬN GỐC -->
                <article class="comment-box comment-item">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="d-flex gap-3">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Avatar" class="user-menu__avatar" style="width: 42px; height: 42px;" />
                            }
                            else
                            {
                                <div class="user-menu__avatar user-menu__avatar--fallback" style="width: 42px; height: 42px; font-size: 1.2rem;">@initial</div>
                            }
                            <div>
                                <a href="#" class="author-link" style="font-size: 1.05rem;">@userName</a>
                                @if (comment.DaGhim)
                                {
                                    <span class="comment-badge"><i class="fas fa-thumbtack"></i> Đã ghim</span>
                                }
                                @if (comment.LaSpoiler)
                                {
                                    <div class="spoiler-content is-hidden mt-2">
                                        <div class="spoiler-warning">
                                            <i class="fas fa-eye-slash"></i>
                                            <span>Bình luận có spoiler</span>
                                            <button type="button" class="btn-ghost py-1 px-2 btn-show-spoiler">Hiện nội dung</button>
                                        </div>
                                        <p class="spoiler-body mb-0 mt-2" style="color: var(--public-text);">@comment.NoiDung</p>
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-0 mt-1" style="color: var(--public-text);">@comment.NoiDung</p>
                                }
                            </div>
                        </div>
                        <div class="text-end" style="min-width: 100px;">
                            <div class="muted small mb-2">@comment.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="comment-action-row mb-1">
                                <button class="comment-action-btn btn-react-comment @(hasReacted ? "is-reacted" : "")" data-id="@comment.MaBinhLuan" type="button" @(hasReacted ? "disabled" : "") title="@(hasReacted ? "Bạn đã thả tim bình luận này" : "Thả tim")">
                                    <i class="fas fa-heart"></i> <span>@comment.SoCamXuc</span>
                                </button>
                                <button class="comment-action-btn btn-report-comment is-danger" data-id="@comment.MaBinhLuan" type="button">
                                    <i class="fas fa-flag"></i> Báo cáo
                                </button>
                                @if (canManageComments)
                                {
                                    <button class="comment-action-btn btn-pin-comment" data-id="@comment.MaBinhLuan" type="button">
                                        <i class="fas fa-thumbtack"></i> @(comment.DaGhim ? "Bỏ ghim" : "Ghim")
                                    </button>
                                }
                            </div>
                            <button class="btn-reply-comment" data-user="@userName" data-id="@comment.MaBinhLuan" style="background:none; border:none; color:var(--public-green); font-size:0.85rem; font-weight:bold; cursor:pointer; padding:0;">
                                <i class="fas fa-reply me-1"></i>Trả lời
                            </button>
                            <!-- NÚT XÓA BÌNH LUẬN GỐC -->
                            @if (currentUserId == comment.MaNguoiDung || isAdmin)
                            {
                                <button class="btn-delete-comment ms-2" data-id="@comment.MaBinhLuan" style="background:none; border:none; color:var(--public-red); font-size:0.85rem; font-weight:bold; cursor:pointer; padding:0;" title="Xóa bình luận">
                                    <i class="fas fa-trash-alt"></i> Xóa
                                </button>
                            }
                        </div>
                    </div>
                </article>

                <!-- BÌNH LUẬN TRẢ LỜI (Thụt lề) -->
                @{
                    var replies = Model.Comments.Where(c => c.MaBinhLuanCha == comment.MaBinhLuan).OrderBy(c => c.NgayTao).ToList();
                }
                @if (replies.Any())
                {
                    <div class="replies-container mt-2" style="margin-left: 3.5rem; border-left: 2px solid var(--public-border); padding-left: 1rem;">
                        @foreach (var rep in replies)
                        {
                            var repUser = rep.NguoiDung?.UserName ?? "Ẩn danh";
                            var repAva = rep.NguoiDung?.Avatar;
                            var repIni = string.IsNullOrWhiteSpace(repUser) ? "U" : repUser.Substring(0, 1).ToUpper();
                            var replyHasReacted = Model.ReactedCommentIds.Contains(rep.MaBinhLuan);

                            <article class="comment-box mt-2 pt-2" style="border-top: 1px dashed rgba(255,255,255,0.1);">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="d-flex gap-2">
                                        @if (!string.IsNullOrWhiteSpace(repAva))
                                        {
                                            <img src="@repAva" class="user-menu__avatar" style="width: 32px; height: 32px;" />
                                        }
                                        else
                                        {
                                            <div class="user-menu__avatar user-menu__avatar--fallback" style="width: 32px; height: 32px; font-size: 1rem;">@repIni</div>
                                        }
                                        <div>
                                            <a href="#" class="author-link" style="font-size: 0.95rem;">@repUser</a>
                                            @if (rep.LaSpoiler)
                                            {
                                                <div class="spoiler-content is-hidden mt-2">
                                                    <div class="spoiler-warning">
                                                        <i class="fas fa-eye-slash"></i>
                                                        <span>Trả lời có spoiler</span>
                                                        <button type="button" class="btn-ghost py-1 px-2 btn-show-spoiler">Hiện nội dung</button>
                                                    </div>
                                                    <p class="spoiler-body mb-0 mt-2" style="color: var(--public-text); font-size: 0.95rem;">@rep.NoiDung</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="mb-0 mt-1" style="color: var(--public-text); font-size: 0.95rem;">@rep.NoiDung</p>
                                            }
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="muted small mb-1">@rep.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="comment-action-row mb-1">
                                            <button class="comment-action-btn btn-react-comment @(replyHasReacted ? "is-reacted" : "")" data-id="@rep.MaBinhLuan" type="button" @(replyHasReacted ? "disabled" : "") title="@(replyHasReacted ? "Bạn đã thả tim bình luận này" : "Thả tim")">
                                                <i class="fas fa-heart"></i> <span>@rep.SoCamXuc</span>
                                            </button>
                                            <button class="comment-action-btn btn-report-comment is-danger" data-id="@rep.MaBinhLuan" type="button">
                                                <i class="fas fa-flag"></i> Báo cáo
                                            </button>
                                        </div>
                                        <button class="btn-reply-comment" data-user="@repUser" data-id="@comment.MaBinhLuan" style="background:none; border:none; color:var(--public-green); font-size:0.8rem; font-weight:bold; cursor:pointer; padding:0;">
                                            <i class="fas fa-reply me-1"></i>Trả lời
                                        </button>
                                        <!-- NÚT XÓA BÌNH LUẬN TRẢ LỜI -->
                                        @if (currentUserId == rep.MaNguoiDung || isAdmin)
                                        {
                                            <button class="btn-delete-comment ms-2" data-id="@rep.MaBinhLuan" style="background:none; border:none; color:var(--public-red); font-size:0.8rem; font-weight:bold; cursor:pointer; padding:0;" title="Xóa bình luận">
                                                <i class="fas fa-trash-alt"></i> Xóa
                                            </button>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                
                <!-- CHỖ TRỐNG ĐỂ CHÈN KHUNG NHẬP TRẢ LỜI VÀO ĐÂY (Facebook style) -->
                <div class="inline-reply-container mt-2" style="margin-left: 3.5rem;"></div>
            </div>
        }
    </div>
    
    @if (parentComments.Count > 10)
    {
        <div class="text-center mt-4">
            <button id="loadMoreCommentsBtn" class="btn-ghost" type="button">Xem thêm bình luận <i class="fas fa-chevron-down ms-1"></i></button>
        </div>
    }

    <!-- KHUNG NHẬP ẨN (Dùng để di chuyển tới các comment) -->
    <div id="inlineReplyTemplate" class="d-none mt-2">
        <div class="d-flex gap-2 align-items-start">
            <textarea id="txtBinhLuanTraLoi" class="field-textarea flex-grow-1" rows="1" placeholder="Viết câu trả lời..." style="min-height: 45px; font-size: 0.95rem; padding: 0.5rem 0.8rem;"></textarea>
            <div class="d-flex gap-2 align-items-center">
                <label class="muted small fw-bold d-inline-flex align-items-center gap-1" style="cursor: pointer; white-space: nowrap;">
                    <input id="chkSpoilerTraLoi" type="checkbox" />
                    Spoiler
                </label>
                <button id="btnHuyTraLoi" class="btn-ghost py-1 px-3" type="button" style="font-size: 0.9rem;">Hủy</button>
                <button id="btnGuiBinhLuanTraLoi" class="btn-neon py-1 px-3" type="button" style="font-size: 0.9rem;"><i class="fas fa-paper-plane me-1"></i>Gửi</button>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        (() => {
            const storyId = @Model.Truyen.MaTruyen;
            const chapterList = document.getElementById("chapterList");
            const chapterSearch = document.getElementById("chapterSearch");
            const chapterSort = document.getElementById("chapterSort");

            chapterSearch?.addEventListener("input", () => {
                const value = chapterSearch.value.trim().toLowerCase();
                chapterList?.querySelectorAll(".chapter-item").forEach(item => {
                    item.hidden = !item.innerText.toLowerCase().includes(value);
                });
            });

            chapterSort?.addEventListener("click", () => {
                const items = Array.from(chapterList.querySelectorAll(".chapter-item"));
                const descending = chapterSort.dataset.sort === "asc";
                items.sort((a, b) => descending
                    ? Number(b.dataset.chapter) - Number(a.dataset.chapter)
                    : Number(a.dataset.chapter) - Number(b.dataset.chapter));
                items.forEach(item => chapterList.appendChild(item));
                chapterSort.dataset.sort = descending ? "desc" : "asc";
            });

            document.querySelectorAll(".story-action-btn").forEach(button => {
                button.addEventListener("click", async () => {
                    const action = button.dataset.action;
                    const form = new FormData();
                    form.append("maTruyen", storyId);

                    const response = await fetch(`/api/TuongTac/${action}`, { method: "POST", body: form });
                    if (response.status === 401) {
                        window.location.href = "/Identity/Account/Login";
                        return;
                    }

                    if (!response.ok) return;
                    const result = await response.json();
                    button.classList.toggle("is-active", result.active);
                    const count = document.querySelector(`[data-count-for="${action}"]`);
                    if (count) count.textContent = result.count;
                });
            });
            // === LOGIC ĐÁNH GIÁ SAO ===
            const ratingRoot = document.getElementById('ratingStars');
            const stars = ratingRoot ? ratingRoot.querySelectorAll('i[data-value]') : [];
            let savedRating = ratingRoot ? Number(ratingRoot.dataset.userRating || 0) : 0;

            function paintStars(value) {
                stars.forEach((s, idx) => {
                    s.style.color = (idx < value) ? "#ffc107" : "#ccc";
                });
            }

            if (ratingRoot) {
                stars.forEach(star => {
                    star.addEventListener('click', async function () {
                        const rating = Number(this.getAttribute('data-value'));
                        const form = new FormData();
                        form.append("maTruyen", storyId);
                        form.append("diemSo", rating);

                        try {
                            const response = await fetch('/api/TuongTac/DanhGia', { method: "POST", body: form });
                            if (response.status === 401) {
                                window.location.href = "/Identity/Account/Login";
                                return;
                            }
                            if (response.ok) {
                                const result = await response.json();
                                savedRating = rating;
                                ratingRoot.dataset.userRating = rating;
                                paintStars(savedRating);

                                const ratingAverage = document.getElementById('ratingAverage');
                                if (ratingAverage && result.diemMoi !== undefined) {
                                    ratingAverage.innerHTML = `<i class="fas fa-star"></i> ${Number(result.diemMoi).toFixed(1)}/5.0`;
                                }

                                const ratingTotal = document.getElementById('ratingTotal');
                                if (ratingTotal && result.totalRatings !== undefined) {
                                    ratingTotal.textContent = `(${result.totalRatings} đánh giá)`;
                                }
                            }
                        } catch (err) {
                            alert('Lỗi kết nối máy chủ.');
                        }
                    });

                    star.addEventListener('mouseover', function () {
                        paintStars(Number(this.getAttribute('data-value')));
                    });
                });

                ratingRoot.addEventListener('mouseleave', function () {
                    paintStars(savedRating);
                });
            }
            const loadMoreBtn = document.getElementById('loadMoreCommentsBtn');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', function() {
                    const hiddenComments = document.querySelectorAll('.comment-thread.d-none');
                    for (let i = 0; i < 10 && i < hiddenComments.length; i++) {
                        hiddenComments[i].classList.remove('d-none');
                    }
                    if (hiddenComments.length <= 10) {
                        loadMoreBtn.style.display = 'none';
                    }
                });
            }

            // === HÀM GỬI AJAX CHUNG ===
            async function postComment(noiDung, parentId = null, btnElement, laSpoiler = false) {
                if (!noiDung) {
                    alert('Vui lòng nhập nội dung!');
                    return;
                }

                const originalHTML = btnElement.innerHTML;
                btnElement.disabled = true;
                btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                const form = new FormData();
                form.append("maTruyen", storyId);
                form.append("noiDung", noiDung);
                form.append("laSpoiler", laSpoiler ? "true" : "false");
                if (parentId) form.append("maBinhLuanCha", parentId);

                try {
                    const response = await fetch('/api/TuongTac/BinhLuan', { method: "POST", body: form });
                    if (response.status === 401) {
                        window.location.href = "/Identity/Account/Login";
                        return;
                    }
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Lỗi khi gửi bình luận.');
                        btnElement.disabled = false;
                        btnElement.innerHTML = originalHTML;
                    }
                } catch (err) {
                    alert('Lỗi kết nối máy chủ.');
                    btnElement.disabled = false;
                    btnElement.innerHTML = originalHTML;
                }
            }

            // === GỬI BÌNH LUẬN GỐC ===
            const btnGuiGoc = document.getElementById('btnGuiBinhLuanGoc');
            const txtGoc = document.getElementById('txtBinhLuanGoc');
            const chkSpoilerGoc = document.getElementById('chkSpoilerGoc');
            if (btnGuiGoc && txtGoc) {
                btnGuiGoc.addEventListener('click', () => postComment(txtGoc.value.trim(), null, btnGuiGoc, chkSpoilerGoc?.checked));
            }

            // === LOGIC TRẢ LỜI FACEBOOK-STYLE ===
            const replyButtons = document.querySelectorAll('.btn-reply-comment');
            const inlineReplyTemplate = document.getElementById('inlineReplyTemplate');
            const txtTraLoi = document.getElementById('txtBinhLuanTraLoi');
            const btnGuiTraLoi = document.getElementById('btnGuiBinhLuanTraLoi');
            const btnHuyTraLoi = document.getElementById('btnHuyTraLoi');
            const chkSpoilerTraLoi = document.getElementById('chkSpoilerTraLoi');
            let currentParentId = null;

            replyButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const username = this.getAttribute('data-user');
                    const parentId = this.getAttribute('data-id');

                    // Tìm container thụt lề của luồng bình luận này
                    const thread = this.closest('.comment-thread');
                    const container = thread.querySelector('.inline-reply-container');

                    // Bê khung nhập ẩn nhét vào container này và hiện lên
                    container.appendChild(inlineReplyTemplate);
                    inlineReplyTemplate.classList.remove('d-none');

                    currentParentId = parentId; // Lưu ID cha
                    
                    let currentText = txtTraLoi.value.trim();
                    if(currentText.startsWith('\x40')) {
                        currentText = currentText.substring(currentText.indexOf(' ') + 1);
                    }
                    txtTraLoi.value = '\x40' + username + ' ' + currentText;
                    
                    txtTraLoi.focus();
                });
            });

            // Gửi bình luận trả lời
            if (btnGuiTraLoi) {
                btnGuiTraLoi.addEventListener('click', () => {
                    postComment(txtTraLoi.value.trim(), currentParentId, btnGuiTraLoi, chkSpoilerTraLoi?.checked);
                });
            }

            // Hủy trả lời (Ẩn khung đi)
            if (btnHuyTraLoi) {
                btnHuyTraLoi.addEventListener('click', () => {
                    inlineReplyTemplate.classList.add('d-none');
                    txtTraLoi.value = '';
                    if (chkSpoilerTraLoi) chkSpoilerTraLoi.checked = false;
                    currentParentId = null;
                    document.body.appendChild(inlineReplyTemplate); // Đưa template ra ngoài body cất
                });
            }
            // === LOGIC XÓA BÌNH LUẬN BẰNG AJAX ===
            document.querySelectorAll('.btn-show-spoiler').forEach(btn => {
                btn.addEventListener('click', function () {
                    const box = this.closest('.spoiler-content');
                    box?.classList.remove('is-hidden');
                    this.closest('.spoiler-warning')?.remove();
                });
            });

            async function postCommentTool(endpoint, commentId) {
                const form = new FormData();
                form.append("maBinhLuan", commentId);
                const response = await fetch(`/api/TuongTac/${endpoint}`, { method: "POST", body: form });
                if (response.status === 401) {
                    window.location.href = "/Identity/Account/Login";
                    return null;
                }
                if (response.status === 403) {
                    alert('Bạn không có quyền thực hiện thao tác này.');
                    return null;
                }
                if (!response.ok) {
                    alert('Có lỗi xảy ra, vui lòng thử lại.');
                    return null;
                }
                return await response.json();
            }

            document.querySelectorAll('.btn-react-comment').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const result = await postCommentTool('CamXucBinhLuan', this.dataset.id);
                    if (result?.count !== undefined) {
                        this.querySelector('span').textContent = result.count;
                    }
                    if (result?.alreadyReacted) {
                        alert(result.message || 'Bạn đã thả tim bình luận này rồi.');
                    }
                    if (result?.success) {
                        this.classList.add('is-reacted');
                        this.disabled = true;
                        this.title = 'Bạn đã thả tim bình luận này';
                    }
                });
            });

            document.querySelectorAll('.btn-report-comment').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const result = await postCommentTool('BaoCaoBinhLuan', this.dataset.id);
                    if (result?.success) {
                        this.innerHTML = '<i class="fas fa-check"></i> Đã báo cáo';
                        this.disabled = true;
                    }
                });
            });

            document.querySelectorAll('.btn-pin-comment').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const result = await postCommentTool('GhimBinhLuan', this.dataset.id);
                    if (result?.success) {
                        window.location.reload();
                    }
                });
            });

            const deleteButtons = document.querySelectorAll('.btn-delete-comment');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', async function() {
                    // Hỏi xác nhận trước khi xóa
                    if (!confirm('Bạn có chắc chắn muốn xóa bình luận này không?')) return;

                    const commentId = this.getAttribute('data-id');
                    const form = new FormData();
                    form.append("maBinhLuan", commentId);

                    try {
                        const response = await fetch('/api/TuongTac/XoaBinhLuan', {
                            method: "POST",
                            body: form
                        });

                        if (response.status === 401) {
                            window.location.href = "/Identity/Account/Login";
                            return;
                        }

                        if (response.status === 403) {
                            alert('Bạn không có quyền xóa bình luận này.');
                            return;
                        }

                        if (response.ok) {
                            // Xóa thành công thì tải lại trang để làm mới danh sách
                            window.location.reload();
                        } else {
                            alert('Có lỗi xảy ra khi xóa bình luận.');
                        }
                    } catch (err) {
                        console.error(err);
                        alert('Lỗi kết nối máy chủ.');
                    }
                });
            });

        })();
    </script>
}
