@model HutechNovel.Models.ReadingViewModel

@{
    ViewData["Title"] = $"Chương {Model.Chapter.SoChuong}";
    bool hasRaw = !string.IsNullOrWhiteSpace(Model.RawContent?.NoiDung);
    bool hasConv = !string.IsNullOrWhiteSpace(Model.ConvertedContent?.NoiDung);
    
    var rawContent = Model.RawContent?.NoiDung;
    var convContent = Model.ConvertedContent?.NoiDung;
    if (!hasRaw && hasConv) rawContent = convContent;
    if (!hasConv && hasRaw) convContent = rawContent;
    
    var displayContent = hasConv ? convContent : (rawContent ?? "");
    var activeMode = hasConv ? "converted" : "raw";
}

<style>
    /* Chuyển đổi màu sắc mượt mà bất chấp Theme hệ thống */
    .reader-page {
        transition: background-color 0.3s ease, color 0.3s ease;
        padding-bottom: 70px;
    }

    .reader-main-card {
        transition: background-color 0.3s ease, color 0.3s ease;
        border: none !important;
        background-color: transparent !important;
    }

    .reader-heading h1, .reader-heading h2 {
        color: inherit !important;
    }

    .reader-content-live p {
        margin-bottom: var(--reader-paragraph-gap, 18px);
        text-indent: 1.5rem; /* Thụt lề đầu dòng cho chuẩn phong cách truyện */
        line-height: inherit;
    }

    .reader-sentence.is-current-paragraph {
        border-left: 3px solid var(--public-green);
        background: rgba(53, 255, 97, 0.08);
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
        padding-left: 0.35rem;
    }

    .reader-progress {
        position: sticky;
        top: 92px;
        z-index: 80;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: center;
        padding: 0.55rem 0.85rem;
        border: 1px solid var(--public-border);
        border-radius: 8px;
        background: var(--public-surface);
        color: var(--public-text);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
        margin-bottom: 1rem;
    }

    .reader-progress__track {
        height: 8px;
        overflow: hidden;
        border-radius: 99px;
        background: var(--public-surface-2);
    }

    .reader-progress__bar {
        width: 0%;
        height: 100%;
        border-radius: inherit;
        background: var(--public-green);
        transition: width 0.12s ease;
    }

    .reader-progress__label {
        min-width: 48px;
        color: var(--public-green);
        font-size: 0.86rem;
        font-weight: 800;
        text-align: right;
    }

    .theme-public .reader-chapter-disabled,
    .theme-public .btn-ghost.reader-chapter-disabled,
    .theme-public .btn-neon.reader-chapter-disabled,
    .reader-chapter-disabled {
        opacity: 0.4 !important;
        filter: grayscale(1);
        cursor: not-allowed !important;
        box-shadow: none !important;
        pointer-events: none !important;
    }

    @@media (max-width: 768px) {
        .reader-progress {
            top: 74px;
        }
    }
    
    /* Giao diện nút TTS trạng thái Tạm Dừng */
    .btn-warning {
        background: #ffb020 !important;
        border-color: #ffb020 !important;
        color: #111 !important;
        font-weight: 700 !important;
        box-shadow: 0 0 16px rgba(255, 176, 32, 0.4) !important;
    }

        .btn-warning:hover {
            background: #e09900 !important;
        }

    /* ── TTS Mini Player (Sticky Bottom) ─────────────────────────────────── */
    #ttsMiniplayer {
        position: fixed; bottom: 0; left: 0; right: 0; z-index: 1050;
        display: flex; align-items: center; gap: 0.75rem;
        padding: 0.55rem 1.2rem 0.65rem;
        background: rgba(12, 12, 12, 0.94);
        backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
        border-top: 1px solid rgba(255,255,255,0.07);
        color: #f1f1f1;
        transform: translateY(100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #ttsMiniplayer.is-visible { transform: translateY(0); }
    .tts-mp-info { flex: 1; min-width: 0; overflow: hidden; }
    .tts-mp-title {
        display: block; font-size: 0.72rem; font-weight: 700;
        color: var(--public-green, #35ff61);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .tts-mp-chapter {
        display: block; font-size: 0.68rem; opacity: 0.6;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .tts-mp-controls, .tts-mp-extras { display: flex; align-items: center; gap: 0.2rem; }
    .tts-mp-controls button, .tts-mp-extras button {
        background: none; border: none; color: #f1f1f1;
        padding: 0.45rem 0.6rem; border-radius: 6px;
        cursor: pointer; font-size: 0.9rem;
        transition: background 0.15s, color 0.15s;
    }
    .tts-mp-controls button:hover, .tts-mp-extras button:hover { background: rgba(255,255,255,0.1); }
    #mpPlayPause { font-size: 1.15rem; padding: 0.45rem 0.75rem; color: var(--public-green, #35ff61); }
    .tts-mp-extras button.is-active { color: var(--public-green, #35ff61); }
    #mpTimerLabel { font-size: 0.65rem; margin-left: 2px; font-variant-numeric: tabular-nums; }
    .tts-mp-progressbar {
        position: absolute; bottom: 0; left: 0;
        height: 2px; background: var(--public-green, #35ff61);
        transition: width 0.4s ease; pointer-events: none;
    }
    /* Resume banner */
    #ttsResumeBanner {
        background: var(--public-surface-2); border: 1px solid var(--public-border);
        border-radius: 8px; padding: 0.55rem 0.85rem;
        display: flex; align-items: center; gap: 0.5rem; font-size: 0.83rem;
    }
    /* Preset buttons */
    .preset-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .btn-preset {
        padding: 0.28rem 0.65rem; border-radius: 20px;
        border: 1px solid var(--public-border);
        background: var(--public-surface-2); color: var(--public-text);
        font-size: 0.76rem; cursor: pointer; transition: all 0.15s;
    }
    .btn-preset:hover { border-color: var(--public-green); color: var(--public-green); }
    .btn-preset.is-active {
        background: var(--public-green); color: #111;
        border-color: var(--public-green); font-weight: 700;
    }
    /* Google TTS paragraph highlight */
    .reader-sentence.is-reading {
        border-left: 3px solid var(--public-green);
        background: rgba(53, 255, 97, 0.10);
        padding-left: 0.35rem;
        box-decoration-break: clone; -webkit-box-decoration-break: clone;
    }
    @@media (max-width: 576px) {
        .tts-mp-info { display: none; }
        #mpTimerLabel { display: none; }
    }

    /* Offcanvas Theme Support */
    .reader-offcanvas {
        background-color: var(--public-surface-2) !important;
        color: var(--public-text) !important;
    }
    
    .reader-input {
        background-color: var(--public-surface-1) !important;
        color: var(--public-text) !important;
        border: 1px solid rgba(128, 128, 128, 0.3) !important;
    }

    .reader-input::placeholder {
        color: var(--public-text);
        opacity: 0.6;
    }

    .reader-list-item {
        background-color: transparent !important;
        color: var(--public-text) !important;
        border-bottom: 1px solid rgba(128, 128, 128, 0.3) !important;
    }

    body.theme-reader-black .btn-close, 
    body.theme-reader-dark .btn-close,
    .theme-dark .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
    }
</style>

<section class="reader-page" id="readerPage">
    <div class="reader-card reader-main-card" id="readerCard">
        <div class="reader-progress" aria-label="Tiến độ đọc">
            <div class="reader-progress__track">
                <div class="reader-progress__bar" id="readerProgressBar"></div>
            </div>
            <div class="reader-progress__label" id="readerProgressLabel">0%</div>
        </div>

        <header class="reader-heading">
            <h1>@Model.Chapter.Truyen.TieuDe</h1>
            <h2>Chương @Model.Chapter.SoChuong: @Model.Chapter.TieuDe</h2>
        </header>

        <nav class="reader-topbar">
            <a class="btn-ghost @(Model.PreviousChapterNumber.HasValue ? "" : "disabled reader-chapter-disabled")"
                   data-empty-chapter="@(!Model.PreviousChapterNumber.HasValue)"
                   aria-disabled="@(!Model.PreviousChapterNumber.HasValue)"
                   asp-controller="DocTruyen" asp-action="Index"
                   asp-route-maTruyen="@Model.Chapter.MaTruyen"
                   asp-route-soChuong="@Model.PreviousChapterNumber">
                <i class="fas fa-chevron-left me-1"></i>Chương trước
            </a>
            <a class="btn-ghost" asp-controller="Truyen" asp-action="ChiTiet" asp-route-id="@Model.Chapter.MaTruyen">Mục lục</a>
            <a id="btnNextChapterTop" class="btn-ghost @(Model.NextChapterNumber.HasValue ? "" : "disabled reader-chapter-disabled")" 
               href="@(Model.NextChapterNumber.HasValue ? Url.Action("Index", "DocTruyen", new { maTruyen = Model.Chapter.MaTruyen, soChuong = Model.NextChapterNumber.Value }) : "#")"
               @(Model.NextChapterNumber.HasValue ? "" : "data-empty-chapter=\"true\"")>Chương sau<i class="fas fa-chevron-right ms-2"></i></a>
        </nav>

        <article id="readingContent" class="reader-content reader-content-live">
            <!-- Nội dung sẽ được render lại bởi JS để giữ xuống dòng và bọc đoạn TTS -->
        </article>

        <nav class="reader-topbar mt-5">
            <a class="btn-ghost @(Model.PreviousChapterNumber.HasValue ? "" : "disabled reader-chapter-disabled")"
                   data-empty-chapter="@(!Model.PreviousChapterNumber.HasValue)"
                   aria-disabled="@(!Model.PreviousChapterNumber.HasValue)"
                   asp-action="Index" asp-route-maTruyen="@Model.Chapter.MaTruyen" asp-route-soChuong="@Model.PreviousChapterNumber">
                <i class="fas fa-chevron-left me-1"></i>Chương trước
            </a>
            <a id="btnNextChapterBottom" class="btn-ghost @(Model.NextChapterNumber.HasValue ? "" : "disabled reader-chapter-disabled")" 
               href="@(Model.NextChapterNumber.HasValue ? Url.Action("Index", "DocTruyen", new { maTruyen = Model.Chapter.MaTruyen, soChuong = Model.NextChapterNumber.Value }) : "#")"
               @(Model.NextChapterNumber.HasValue ? "" : "data-empty-chapter=\"true\"")>Chương sau<i class="fas fa-chevron-right ms-2"></i></a>
        </nav>

        <div class="reader-switches justify-content-center mt-4">
            <button class="btn-pill @(activeMode == "raw" ? "is-active" : "") @(hasRaw ? "" : "disabled opacity-50")" 
                    type="button" data-content-mode="raw" 
                    @(hasRaw ? "" : "disabled title=\"Chưa có bản gốc\"")>Bản gốc (Raw)</button>
            <button class="btn-pill @(activeMode == "converted" ? "is-active" : "") @(hasConv ? "" : "disabled opacity-50")" 
                    type="button" data-content-mode="converted" 
                    @(hasConv ? "" : "disabled title=\"Chưa có bản convert\"")>Bản convert</button>
        </div>

    </div>
</section>

<div class="reader-floating-tools">
    <button class="reader-float-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#readerSettings" title="Cài đặt giao diện">
        <i class="fas fa-gear"></i>
    </button>
    <button class="reader-float-btn reader-float-btn--accent" type="button" data-bs-toggle="offcanvas" data-bs-target="#ttsPanel" title="Text to speech">
        <i class="fas fa-volume-high"></i>
    </button>
    <button class="reader-float-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#tocPanel" title="Mục lục nhanh">
        <i class="fas fa-list"></i>
    </button>
    <button class="reader-float-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#replaceTextPanel" title="Sửa Name (Thay chữ)">
        <i class="fas fa-pen-nib"></i>
    </button>
</div>

<!-- PANEL SỬA NAME (REPLACE TEXT) -->
<div class="offcanvas offcanvas-start reader-offcanvas" tabindex="-1" id="replaceTextPanel">
    <div class="offcanvas-header border-bottom" style="border-color: rgba(128,128,128,0.3) !important;">
        <h5 class="offcanvas-title fw-bold">Từ điển cá nhân</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column gap-3">
        <p class="small text-muted mb-0">Thay thế các từ không ưng ý (Ví dụ: tiểu tử &rarr; thằng nhóc). Chỉ áp dụng riêng cho truyện này và lưu trên máy của bạn.</p>
        <form id="addReplaceNameForm" class="d-flex flex-column gap-2">
            <input type="text" id="originalWord" class="form-control reader-input" placeholder="Từ gốc (cần thay)" required />
            <input type="text" id="replacementWord" class="form-control reader-input" placeholder="Thay bằng..." required />
            <button type="submit" class="btn-neon mt-1 w-100" style="padding: 0.5rem;">Thêm quy tắc</button>
        </form>
        <hr class="border-secondary my-1" />
        <h6 class="fw-bold mb-0">Danh sách đã thêm:</h6>
        <div id="replaceNameList" class="d-flex flex-column gap-2" style="overflow-y: auto;">
            <!-- Render rules here -->
        </div>
    </div>
</div>


<!-- PANEL MỤC LỤC -->
<div class="offcanvas offcanvas-start reader-offcanvas" tabindex="-1" id="tocPanel">
    <div class="offcanvas-header border-bottom" style="border-color: rgba(128,128,128,0.3) !important;">
        <h5 class="offcanvas-title fw-bold">Mục lục nhanh</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0 d-flex flex-column">
        <div class="p-3 border-bottom" style="position: sticky; top: 0; background-color: var(--public-surface-2); z-index: 10; border-color: rgba(128,128,128,0.3) !important;">
            <input type="text" id="quickTocSearch" class="form-control reader-input" placeholder="Tìm theo số hoặc tên chương..." />
        </div>
        <div class="list-group list-group-flush" id="quickTocList" style="overflow-y: auto;">
            @foreach (var ch in Model.Chapters.OrderBy(c => c.SoChuong))
            {
                <a href="@Url.Action("Index", "DocTruyen", new { maTruyen = Model.Chapter.MaTruyen, soChuong = ch.SoChuong })" 
                   class="list-group-item list-group-item-action reader-list-item @(ch.MaChuong == Model.Chapter.MaChuong ? "active fw-bold text-success" : "")">
                    @(ch.LaPhuChuong ? "Phụ chương" : $"Chương {ch.SoChuong}"): @ch.TieuDe
                </a>
            }
        </div>
    </div>
</div>

<!-- PANEL CÀI ĐẶT GIAO DIỆN -->
<div class="offcanvas offcanvas-end reader-offcanvas" tabindex="-1" id="readerSettings">
    <div class="offcanvas-header border-bottom" style="border-color: rgba(128,128,128,0.3) !important;">
        <h5 class="offcanvas-title fw-bold">Cài đặt đọc truyện</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="setting-group">
            <label>Bảng màu giao diện</label>
            <div class="setting-swatches flex-wrap">
                <button class="swatch border border-secondary" style="background: linear-gradient(135deg, #ffffff 50%, #1a1a1a 50%); position: relative; overflow: hidden;" data-bg="sync" data-text="sync" title="Đồng bộ (Sáng/Tối)">
                    <i class="fas fa-sync-alt position-absolute top-50 start-50 translate-middle text-secondary" style="opacity: 0.5;"></i>
                </button>
                <button class="swatch" style="background:#ffffff" data-bg="#ffffff" data-text="#1a1a1a" title="Trắng"></button>
                <button class="swatch" style="background:#f4ecd8" data-bg="#f4ecd8" data-text="#332b21" title="Giấy vàng"></button>
                <button class="swatch" style="background:#1a1a1a" data-bg="#1a1a1a" data-text="#e7e2d8" title="Đen tuyền"></button>
                <button class="swatch" style="background:#111b33" data-bg="#111b33" data-text="#9fb1d1" title="Xanh dương tối"></button>
                <button class="swatch" style="background:#2f2338" data-bg="#2f2338" data-text="#e0d4e5" title="Tím tối"></button>
                <button class="swatch" style="background:#2a3b2c" data-bg="#2a3b2c" data-text="#b4cfb6" title="Xanh lá tối"></button>
            </div>
        </div>

        <div class="setting-group d-flex gap-4">
            <div>
                <label>Tự chọn màu nền</label>
                <input type="color" id="customBg" class="reader-color-input d-block mt-1" value="#111111" />
            </div>
            <div>
                <label>Tự chọn màu chữ</label>
                <input type="color" id="customText" class="reader-color-input d-block mt-1" value="#f1f1f1" />
            </div>
        </div>

        <div class="setting-group">
            <label>Font chữ</label>
            <select id="fontFamily" class="field-select">
                <option value="'Palatino Linotype', 'Book Antiqua', Palatino, serif">Palatino (Chuẩn sách)</option>
                <option value="'Times New Roman', Times, serif">Times New Roman</option>
                <option value="'Inter', sans-serif">Inter (Hiện đại)</option>
                <option value="Arial, sans-serif">Arial</option>
            </select>
        </div>

        <div class="setting-group">
            <label>Cỡ chữ: <span id="fontSizeValue" class="text-success fw-bold">22px</span></label>
            <input type="range" id="fontSize" class="form-range" min="16" max="36" value="22" />
        </div>

        <div class="setting-group">
            <label>Giãn dòng: <span id="lineHeightValue" class="text-success fw-bold">1.8</span></label>
            <input type="range" id="lineHeight" class="form-range" min="1.2" max="2.6" step="0.1" value="1.8" />
        </div>

        <div class="setting-group">
            <label>Khoảng cách đoạn: <span id="paragraphGapValue" class="text-success fw-bold">18px</span></label>
            <input type="range" id="paragraphGap" class="form-range" min="8" max="40" value="18" />
        </div>
    </div>
</div>

<!-- PANEL TEXT TO SPEECH -->
<div class="offcanvas offcanvas-end reader-offcanvas tts-offcanvas" tabindex="-1" id="ttsPanel">
    <div class="offcanvas-header border-bottom" style="border-color: rgba(128,128,128,0.3) !important;">
        <h5 class="offcanvas-title fw-bold">Máy đọc truyện (TTS) <small class="fw-normal opacity-50" style="font-size:0.7rem;">Google TTS</small></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column gap-3">

        <!-- Resume Banner -->
        <div id="ttsResumeBanner" hidden>
            <i class="fas fa-history text-success"></i>
            <span>Nghe tiếp từ đoạn <strong id="resumeBlockLabel">?</strong>?</span>
            <button id="btnResumeYes"  class="btn-neon ms-auto py-0 px-2" style="font-size:0.8rem;">Nghe tiếp</button>
            <button id="btnResumeDismiss" class="btn-ghost py-0 px-2"   style="font-size:0.8rem;">Bỏ qua</button>
        </div>

        <!-- Cài đặt giọng đọc (Đóng gói) -->
        <details class="tts-advanced-settings p-2 rounded" style="background: var(--public-surface-1); border: 1px solid var(--public-border);">
            <summary class="fw-bold" style="cursor: pointer; font-size: 0.9rem; user-select: none;">
                <i class="fas fa-sliders-h me-2 text-success"></i>Tùy chỉnh giọng đọc & Tốc độ
            </summary>
            <div class="mt-3 d-flex flex-column gap-3">
                <!-- Language -->
                <div class="setting-group mb-0">
                    <label>Ngôn ngữ đọc:</label>
                    <select id="ttsLang" class="field-select" style="font-size:0.9rem;">
                        <option value="auto" selected>✨ Tự động nhận diện</option>
                        <option value="vi">🇻🇳 Tiếng Việt</option>
                        <option value="zh-CN">🇨🇳 Tiếng Trung (Giản thể)</option>
                        <option value="zh-TW">🇹🇼 Tiếng Trung (Phồn thể)</option>
                        <option value="en">🇺🇸 Tiếng Anh</option>
                        <option value="ja">🇯🇵 Tiếng Nhật</option>
                        <option value="ko">🇰🇷 Tiếng Hàn</option>
                    </select>
                </div>

                <!-- Presets -->
                <div class="setting-group mb-0">
                    <label>Chế độ giọng đọc:</label>
                    <div class="preset-pills">
                        <button class="btn-preset is-active" data-preset="normal">Bình thường</button>
                        <button class="btn-preset" data-preset="slow">Chậm rãi</button>
                        <button class="btn-preset" data-preset="dramatic">Kịch tính</button>
                        <button class="btn-preset" data-preset="cultivation">Tu luyện</button>
                        <button class="btn-preset" data-preset="latenight">Đêm khuya</button>
                    </div>
                </div>

                <!-- Rate -->
                <div class="setting-group mb-0">
                    <label>Tốc độ: <span id="ttsRateValue" class="text-success fw-bold">1.0</span></label>
                    <input type="range" id="ttsRate" class="form-range" min="0.5" max="2.0" step="0.05" value="1" />
                </div>
            </div>
        </details>

        <!-- Controls -->
        <div class="tts-controls d-flex align-items-center">
            <button id="ttsPrev" class="btn-ghost" type="button" title="Lùi 1 đoạn" style="padding:0.6rem 1rem;"><i class="fas fa-backward-step"></i></button>
            <button id="ttsPlayPause" class="btn-neon flex-grow-1" type="button"><i class="fas fa-play me-1"></i>Đọc ngay</button>
            <button id="ttsNext" class="btn-ghost" type="button" title="Tiến 1 đoạn" style="padding:0.6rem 1rem;"><i class="fas fa-forward-step"></i></button>
            <button id="ttsStop" class="btn-ghost" type="button" title="Dừng hẳn" style="padding:0.6rem 1rem;"><i class="fas fa-stop"></i></button>
        </div>

        <!-- Jump to -->
        <div class="d-flex gap-2 align-items-center p-2 rounded" style="background:var(--public-surface-2);border:1px solid var(--public-border);">
            <label class="mb-0 fw-bold" style="white-space:nowrap;font-size:0.85rem;">Nhảy đến đoạn:</label>
            <input type="number" id="ttsJumpInput" class="field text-center" style="width:70px;padding:0.3rem;" min="1" placeholder="VD: 5" />
            <button id="ttsJumpBtn" class="btn-neon py-1 px-3">Đi</button>
        </div>
        <div id="sentenceList" class="sentence-list mt-1"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tts-engine.js"></script>
    <script src="~/js/tts-ui.js"></script>
    <script>
        (() => {
            const content = document.getElementById("readingContent");
            const page = document.getElementById("readerPage");
            const readerCard = document.getElementById("readerCard");
            const settingsKey = "hutechnovel-reader-settings";
            const chapterId = @Model.Chapter.MaChuong;
            const savedReadingPosition = @Json.Serialize(Model.SavedReadingPosition ?? "0");
            const serverThemeJson = @Json.Serialize(Model.ReaderThemeJson ?? "");
            const serverFont = @Json.Serialize(Model.ReaderFontFamily);
            const serverFontSize = @Model.ReaderFontSize;
            const progressBar = document.getElementById("readerProgressBar");
            const progressLabel = document.getElementById("readerProgressLabel");
            let hasRestoredReadingPosition = false;
            let savePositionTimer = null;
            let saveSettingsTimer = null;

            document.querySelectorAll('[data-empty-chapter]').forEach(button => {
                if (button.dataset.emptyChapter?.toLowerCase() !== "true") return;

                button.addEventListener("click", event => {
                    event.preventDefault();
                    alert("Đã hết chương rồi");
                });
            });
            
            // Xử lý dữ liệu raw từ Server: Ép thẻ xuống dòng thành chuỗi text có ký tự \n
            let serverRawStr = @Json.Serialize(Model.RawContent?.NoiDung ?? "");
            let serverConvStr = @Json.Serialize(Model.ConvertedContent?.NoiDung ?? "");
            
            if (!serverRawStr && serverConvStr) serverRawStr = serverConvStr;
            if (!serverConvStr && serverRawStr) serverConvStr = serverRawStr;
            
            const serverRaw = serverRawStr;
            const serverConv = serverConvStr;
            
            // Replace Text (Sửa Name) Logic variables
            const maTruyen = @Model.Chapter.MaTruyen;
            const replaceKey = 'hutechnovel_replacements_' + maTruyen;
            const replaceForm = document.getElementById('addReplaceNameForm');
            const replaceList = document.getElementById('replaceNameList');
            let replaceRules = JSON.parse(localStorage.getItem(replaceKey) || '[]');
            
            let pRaw = [];
            let pConv = [];
            
            // Hàm chuyển đổi nội dung thành HTML với cấu trúc chia đoạn <p>
            function processTextToHTML(text) {
                // Chuyển thẻ ngắt dòng thành \n để tách đoạn
                let cleanText = text.replace(/<br\s*\/?>/gi, '\n').replace(/<\/p>/gi, '\n').replace(/<p[^>]*>/gi, '');
                
                let paragraphs = cleanText.split('\n').map(p => p.trim()).filter(p => {
                    if (p === "") return false;
                    // Nếu có thẻ img thì giữ lại
                    if (p.toLowerCase().includes("<img")) return true;
                    // Kiểm tra xem nội dung chữ (sau khi bỏ HTML tags và giải mã entities) có rỗng không
                    let tempDiv = document.createElement("div");
                    tempDiv.innerHTML = p;
                    let textOnly = tempDiv.textContent || tempDiv.innerText || "";
                    // Regex \s bao gồm cả khoảng trắng thường, \u00A0 (nbsp) và \u3000 (khoảng trắng fullwidth)
                    return textOnly.replace(/[\s\u00A0\u3000]+/g, '').length > 0;
                });
                return paragraphs;
            }

            function applyTextReplacements() {
                // Chuẩn hóa Unicode (NFC) để tránh lỗi gõ tiếng Việt (VD: ệ = e + dấu nặng)
                let rawCopy = serverRaw ? serverRaw.normalize('NFC') : "";
                let convCopy = serverConv ? serverConv.normalize('NFC') : "";

                if (replaceRules.length > 0) {
                    replaceRules.forEach(rule => {
                        let orig = (rule.original || "").normalize('NFC').trim();
                        if (!orig) return;

                        let escapedOriginal = orig.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                        // Hỗ trợ mọi khoảng trắng (space thường, tab, khoảng trắng HTML...)
                        escapedOriginal = escapedOriginal.replace(/\s+/g, '(?:\\s|&nbsp;)+');

                        const regex = new RegExp(escapedOriginal, 'gi');
                        rawCopy = rawCopy.replace(regex, rule.replacement);
                        convCopy = convCopy.replace(regex, rule.replacement);
                    });
                }
                
                pRaw = processTextToHTML(rawCopy);
                pConv = processTextToHTML(convCopy);
            }
            
            // Khởi chạy lúc đầu
            applyTextReplacements();

            // "ttsBlocks" chứa các ĐOẠN VĂN (Paragraph) nguyên vẹn để TTS đọc
            let ttsBlocks = [];
            let recenterTimer = null;
            let currentTTSBlock = 0;   // Index đoạn hiện tại (sync với TTSEngine)
            let ttsState = 'stopped';  // 'playing' | 'paused' | 'stopped'

            // 1. CHUẨN BỊ NỘI DUNG VÀ TÁCH ĐOẠN ĐỂ TTS ĐỌC
            function prepareBlocks() {
                const rawBtn = document.querySelector('[data-content-mode="raw"]');
                const rawMode = rawBtn ? rawBtn.classList.contains("is-active") : false;
                const paragraphs = rawMode ? pRaw : pConv;
                
                ttsBlocks = [];
                let globalIndex = 0;
                
                let htmlOutput = paragraphs.map(p => {
                    let trimmed = p.trim();
                    if (!trimmed) return "";
                    
                    // Trích xuất chữ thuần túy (bỏ thẻ img, b, i...) cho máy đọc TTS
                    let tempDiv = document.createElement("div");
                    tempDiv.innerHTML = trimmed;
                    let textOnly = tempDiv.textContent || tempDiv.innerText || "";
                    
                    ttsBlocks.push(textOnly.trim());
                    
                    let span = `<span class="reader-sentence" id="block-${globalIndex}" data-index="${globalIndex}">${trimmed}</span>`;
                    globalIndex++;
                    
                    return `<p>${span}</p>`;
                }).join("");

                content.innerHTML = htmlOutput;
                renderBlockList();
                restoreReadingPositionOnce();
                initTTSEngine(); // Cập nhật engine với blocks mới
            }

            // In danh sách ra bên ngoài Panel TTS
            function renderBlockList() {
                const list = document.getElementById("sentenceList");
                if (!list) return;
                list.innerHTML = ttsBlocks.map((block, index) => {
                    let preview = block.length > 90 ? block.substring(0, 90) + "..." : block;
                    return `<button type="button" class="text-start" data-jump="${index}"><b>Đoạn ${index + 1}:</b> ${preview}</button>`;
                }).join("");
                
                list.querySelectorAll("[data-jump]").forEach(button => {
                    button.addEventListener("click", () => {
                        TTSEngine.play(Number(button.dataset.jump));
                    });
                });
            }

            function readSavedPosition() {
                if (!savedReadingPosition) return { scrollY: 0, paragraphIndex: 0 };
                try {
                    const parsed = JSON.parse(savedReadingPosition);
                    return {
                        scrollY: Number(parsed.scrollY || 0),
                        paragraphIndex: Number(parsed.paragraphIndex || 0)
                    };
                } catch {
                    return { scrollY: Number(savedReadingPosition || 0), paragraphIndex: 0 };
                }
            }

            function restoreReadingPositionOnce() {
                if (hasRestoredReadingPosition) return;
                hasRestoredReadingPosition = true;

                const position = readSavedPosition();
                window.requestAnimationFrame(() => {
                    setTimeout(() => {
                        if (position.scrollY > 0) {
                            window.scrollTo({ top: position.scrollY, behavior: "auto" });
                        } else if (position.paragraphIndex > 0) {
                            scrollToBlock(position.paragraphIndex, true);
                        }
                        updateReadingProgress();
                    }, 120);
                });
            }

            function getCurrentParagraphIndex() {
                const blocks = Array.from(document.querySelectorAll(".reader-sentence"));
                if (!blocks.length) return 0;

                let current = 0;
                const marker = window.innerHeight * 0.36;
                for (let i = 0; i < blocks.length; i++) {
                    if (blocks[i].getBoundingClientRect().top <= marker) {
                        current = i;
                    } else {
                        break;
                    }
                }
                return current;
            }

            function markCurrentParagraph(index) {
                document.querySelectorAll(".reader-sentence.is-current-paragraph").forEach(el => el.classList.remove("is-current-paragraph"));
                document.getElementById(`block-${index}`)?.classList.add("is-current-paragraph");
            }

            function getReadingSnapshot() {
                const scrollable = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
                const scrollY = Math.max(0, window.scrollY || document.documentElement.scrollTop || 0);
                const progress = Math.min(100, Math.max(0, Math.round((scrollY / scrollable) * 100)));
                const paragraphIndex = getCurrentParagraphIndex();
                return { scrollY: Math.round(scrollY), progress, paragraphIndex };
            }

            function updateReadingProgress() {
                const snapshot = getReadingSnapshot();
                if (progressBar) progressBar.style.width = `${snapshot.progress}%`;
                if (progressLabel) progressLabel.textContent = `${snapshot.progress}%`;
                markCurrentParagraph(snapshot.paragraphIndex);
                return snapshot;
            }

            async function saveReadingPositionNow(useBeacon = false) {
                const snapshot = updateReadingProgress();
                const form = new FormData();
                form.append("maChuong", chapterId);
                form.append("viTriDoc", JSON.stringify(snapshot));


                if (useBeacon && navigator.sendBeacon) {
                    navigator.sendBeacon("/api/TuongTac/LuuViTriDoc", form);
                    return;
                }

                try {
                    await fetch("/api/TuongTac/LuuViTriDoc", { method: "POST", body: form, keepalive: useBeacon });
                } catch {
                    // Khách chưa đăng nhập hoặc mất mạng thì chỉ bỏ qua, không làm gián đoạn việc đọc.
                }
            }

            function scheduleSaveReadingPosition() {
                updateReadingProgress();
                clearTimeout(savePositionTimer);
                savePositionTimer = setTimeout(() => saveReadingPositionNow(false), 1200);
            }

            // ── 2. TTS ENGINE v2 (Google Translate TTS) ────────────────────────────
            const VOICE_PRESETS = {
                normal:      { rate: 1.0  },
                slow:        { rate: 0.75 },
                dramatic:    { rate: 1.15 },
                cultivation: { rate: 1.3  },
                latenight:   { rate: 0.85 }
            };

            function scrollToBlock(index, instant = false) {
                const target = document.getElementById(`block-${index}`);
                if (!target) return;
                target.scrollIntoView({ behavior: instant ? "auto" : "smooth", block: "center" });
            }

            function highlightBlock(index) {
                document.querySelectorAll(".reader-sentence.is-reading").forEach(el => el.classList.remove("is-reading"));
                document.querySelectorAll(".sentence-list .is-reading").forEach(el => el.classList.remove("is-reading"));
                document.getElementById(`block-${index}`)?.classList.add("is-reading");
                let listBtn = document.querySelector(`[data-jump="${index}"]`);
                if (listBtn) {
                    listBtn.classList.add("is-reading");
                    listBtn.scrollIntoView({ behavior: "smooth", block: "nearest" });
                }
                clearTimeout(recenterTimer);
                recenterTimer = setTimeout(() => scrollToBlock(index), 1500);
            }

            // ── 3. PLAY/PAUSE UI ──────────────────────────────────────────────────────
            function updatePlayPauseUI(isPlaying) {
                const btn = document.getElementById("ttsPlayPause");
                if (!btn) return;
                if (isPlaying) {
                    btn.innerHTML = '<i class="fas fa-pause me-1"></i>Tạm dừng';
                    btn.classList.remove("btn-neon"); btn.classList.add("btn-warning");
                } else {
                    btn.innerHTML = '<i class="fas fa-play me-1"></i>Đọc tiếp';
                    btn.classList.remove("btn-warning"); btn.classList.add("btn-neon");
                }
            }

            function initTTSEngine() {
                const langSel = document.getElementById('ttsLang');
                const lang = langSel?.value || 'vi';
                const rate = Number(document.getElementById('ttsRate')?.value || 1.0);

                TTSEngine.init(ttsBlocks, {
                    lang, rate,
                    onBlockStart(blockIdx) {
                        currentTTSBlock = blockIdx;
                        ttsState = 'playing';
                        highlightBlock(blockIdx);
                        updatePlayPauseUI(true);
                        const status = document.getElementById('ttsStatus');
                        if (status) status.textContent = `Đang đọc đoạn ${blockIdx + 1}/${ttsBlocks.length}`;
                        TTSMiniPlayer.onBlockStart(blockIdx);
                    },
                    onStateChange(isPlaying) {
                        if (!isPlaying && ttsState === 'playing') ttsState = 'paused';
                        updatePlayPauseUI(isPlaying);
                        TTSMiniPlayer.onStateChange(isPlaying);
                    },
                    onChapterEnd() {
                        ttsState = 'stopped';
                        updatePlayPauseUI(false);
                        TTSMiniPlayer.onChapterEnd();
                        const nextBtn = document.getElementById('btnNextChapterBottom');
                        if (nextBtn && !nextBtn.classList.contains('disabled')) {
                            const status = document.getElementById('ttsStatus');
                            if (status) status.textContent = 'Chuyển sang chương tiếp theo...';
                            setTimeout(() => { window.location.href = nextBtn.href; }, 1200);
                        } else {
                            const status = document.getElementById('ttsStatus');
                            if (status) status.textContent = 'Đã đọc hết chương cuối!';
                        }
                    },
                    onStop() {
                        ttsState = 'stopped';
                        updatePlayPauseUI(false);
                        TTSMiniPlayer.onStop();
                        document.querySelectorAll('.reader-sentence.is-reading')
                            .forEach(el => el.classList.remove('is-reading'));
                    }
                });
            }

            // ── Resume Banner ─────────────────────────────────────────────────────
            document.getElementById('btnResumeYes')?.addEventListener('click', () => {
                const lbl = document.getElementById('resumeBlockLabel');
                const idx = lbl ? parseInt(lbl.textContent) - 1 : 0;
                document.getElementById('ttsResumeBanner').hidden = true;
                TTSEngine.play(idx);
            });
            document.getElementById('btnResumeDismiss')?.addEventListener('click', () => {
                document.getElementById('ttsResumeBanner').hidden = true;
                TTSMiniPlayer.clearResume();
            });

            // ── TTS Panel Buttons ────────────────────────────────────────────────
            document.getElementById('ttsPlayPause').addEventListener('click', () => {
                if (ttsState === 'playing') {
                    TTSEngine.pause(); ttsState = 'paused';
                    const s = document.getElementById('ttsStatus');
                    if (s) s.textContent = 'Đã tạm dừng.';
                } else if (ttsState === 'paused') {
                    TTSEngine.resume(); ttsState = 'playing';
                } else {
                    TTSEngine.play(currentTTSBlock);
                }
            });

            document.getElementById('ttsStop').addEventListener('click', () => {
                TTSEngine.stop();
                currentTTSBlock = 0; ttsState = 'stopped';
                const s = document.getElementById('ttsStatus');
                if (s) s.textContent = 'Đã dừng. Sẵn sàng đọc lại từ đầu.';
            });

            document.getElementById('ttsPrev').addEventListener('click', () => TTSEngine.prev());
            document.getElementById('ttsNext').addEventListener('click', () => TTSEngine.next());

            document.getElementById('ttsJumpBtn').addEventListener('click', () => {
                const val = parseInt(document.getElementById('ttsJumpInput').value);
                if (!isNaN(val) && val >= 1 && val <= ttsBlocks.length) {
                    TTSEngine.play(val - 1);
                } else {
                    alert(`Nhập số từ 1 đến ${ttsBlocks.length}`);
                }
            });

            document.getElementById('ttsRate').addEventListener('input', e => {
                const rate = Number(e.target.value);
                document.getElementById('ttsRateValue').textContent = rate.toFixed(1);
                TTSEngine.setRate(rate);
            });

            document.getElementById('ttsLang').addEventListener('change', e => {
                TTSEngine.setLang(e.target.value);
            });

            document.querySelectorAll('[data-preset]').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('[data-preset]').forEach(b => b.classList.remove('is-active'));
                    btn.classList.add('is-active');
                    const rate = VOICE_PRESETS[btn.dataset.preset]?.rate ?? 1.0;
                    TTSEngine.setRate(rate);
                    const slider = document.getElementById('ttsRate');
                    if (slider) { slider.value = rate; document.getElementById('ttsRateValue').textContent = rate.toFixed(2); }
                });
            });

            // 4. QUẢN LÝ GIAO DIỆN (THEMING)
            function parseServerReaderTheme() {
                if (!serverThemeJson) return {};
                try {
                    return JSON.parse(serverThemeJson);
                } catch {
                    return {};
                }
            }

            function defaultReaderSettings() {
                return {
                    bg: "#111111",
                    text: "#f1f1f1",
                    font: serverFont || "'Palatino Linotype', 'Book Antiqua', Palatino, serif",
                    fontSize: serverFontSize || 22,
                    lineHeight: 1.8,
                    paragraphGap: 18,
                    ...parseServerReaderTheme()
                };
            }

            function applySettings(settings) {
                if (settings.bg === "sync" || settings.text === "sync") {
                    page.style.backgroundColor = "";
                    page.style.color = "";
                    readerCard.style.color = "";
                    content.style.color = "";
                    document.getElementById("customBg").value = "#000000";
                    document.getElementById("customText").value = "#ffffff";
                } else {
                    page.style.backgroundColor = settings.bg;
                    page.style.color = settings.text;
                    readerCard.style.color = settings.text;
                    content.style.color = settings.text;
                    document.getElementById("customBg").value = settings.bg;
                    document.getElementById("customText").value = settings.text;
                }
                
                content.style.fontFamily = settings.font;
                content.style.fontSize = `${settings.fontSize}px`;
                content.style.lineHeight = settings.lineHeight;
                content.style.setProperty("--reader-paragraph-gap", `${settings.paragraphGap}px`);

                document.getElementById("fontFamily").value = settings.font;
                document.getElementById("fontSize").value = settings.fontSize;
                document.getElementById("fontSizeValue").textContent = `${settings.fontSize}px`;
                document.getElementById("lineHeight").value = settings.lineHeight;
                document.getElementById("lineHeightValue").textContent = settings.lineHeight;
                document.getElementById("paragraphGap").value = settings.paragraphGap;
                document.getElementById("paragraphGapValue").textContent = `${settings.paragraphGap}px`;
            }

            async function saveReaderSettingsToAccount(settings) {
                const form = new FormData();
                form.append("bg", settings.bg);
                form.append("text", settings.text);
                form.append("font", settings.font);
                form.append("fontSize", settings.fontSize);
                form.append("lineHeight", settings.lineHeight);
                form.append("paragraphGap", settings.paragraphGap);

                try {
                    await fetch("/api/TuongTac/LuuCaiDatDoc", { method: "POST", body: form });
                } catch {
                    // Nếu chưa đăng nhập thì localStorage vẫn giữ cài đặt trên máy hiện tại.
                }
            }

            function scheduleSaveReaderSettings(settings) {
                clearTimeout(saveSettingsTimer);
                saveSettingsTimer = setTimeout(() => saveReaderSettingsToAccount(settings), 650);
            }

            function saveSettings(patch) {
                const current = JSON.parse(localStorage.getItem(settingsKey) || "{}");
                const next = {
                    ...defaultReaderSettings(),
                    ...current,
                    ...patch
                };
                localStorage.setItem(settingsKey, JSON.stringify(next));
                applySettings(next);
                scheduleSaveReaderSettings(next);
            }

            document.querySelectorAll("[data-bg]").forEach(button => {
                button.addEventListener("click", () => saveSettings({ bg: button.dataset.bg, text: button.dataset.text }));
            });
            document.getElementById("customBg").addEventListener("input", e => saveSettings({ bg: e.target.value }));
            document.getElementById("customText").addEventListener("input", e => saveSettings({ text: e.target.value }));
            document.getElementById("fontFamily").addEventListener("change", e => saveSettings({ font: e.target.value }));
            document.getElementById("fontSize").addEventListener("input", e => saveSettings({ fontSize: Number(e.target.value) }));
            document.getElementById("lineHeight").addEventListener("input", e => saveSettings({ lineHeight: Number(e.target.value) }));
            document.getElementById("paragraphGap").addEventListener("input", e => saveSettings({ paragraphGap: Number(e.target.value) }));
            // (ttsRate listener đã được đăng ký trong phần TTS Engine v2 phía trên)

            // Switch chế độ Raw/Convert
            document.querySelectorAll("[data-content-mode]").forEach(button => {
                button.addEventListener("click", () => {
                    document.querySelectorAll("[data-content-mode]").forEach(btn => btn.classList.remove("is-active"));
                    button.classList.add("is-active");
                    TTSEngine.stop();
                    updatePlayPauseUI(false);
                    prepareBlocks(); // initTTSEngine() được gọi bên trong
                });
            });

            // Phím tắt chuyển chương
            document.addEventListener('keydown', function(e) {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
                if (e.key === 'ArrowLeft') {
                    const prevBtn = document.querySelector('.reader-topbar a.btn-ghost');
                    if (prevBtn && !prevBtn.classList.contains('disabled')) window.location.href = prevBtn.href;
                } else if (e.key === 'ArrowRight') {
                    const nextBtn = document.getElementById('btnNextChapterTop');
                    if (nextBtn && !nextBtn.classList.contains('disabled')) window.location.href = nextBtn.href;
                }
            });


            // Quick TOC Search
            document.getElementById('quickTocSearch')?.addEventListener('input', function(e) {
                const keyword = e.target.value.toLowerCase();
                const items = document.querySelectorAll('#quickTocList .list-group-item');
                items.forEach(item => {
                    if (item.textContent.toLowerCase().includes(keyword)) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });

            function renderReplaceRules() {
                if (!replaceList) return;
                replaceList.innerHTML = '';
                if (replaceRules.length === 0) {
                    replaceList.innerHTML = '<span class="text-muted small">Chưa có quy tắc nào.</span>';
                    return;
                }
                replaceRules.forEach((rule, index) => {
                    const div = document.createElement('div');
                    div.className = 'd-flex justify-content-between align-items-center p-2 rounded bg-dark border border-secondary';
                    div.innerHTML = `
                        <div class="small text-light text-break">
                            <span class="text-danger fw-bold">${rule.original}</span> 
                            <i class="fas fa-arrow-right mx-1 text-muted"></i> 
                            <span class="text-success fw-bold">${rule.replacement}</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1 ms-2" onclick="removeReplaceRule(${index})" title="Xóa">
                            <i class="fas fa-trash"></i>
                        </button>
                    `;
                    replaceList.appendChild(div);
                });
            }

            window.removeReplaceRule = function(index) {
                replaceRules.splice(index, 1);
                localStorage.setItem(replaceKey, JSON.stringify(replaceRules));
                renderReplaceRules();
                applyTextReplacements();
                prepareBlocks();
            };

            if (replaceForm) {
                replaceForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const orig = document.getElementById('originalWord').value.trim();
                    const repl = document.getElementById('replacementWord').value.trim();
                    if (orig && repl) {
                        if (!replaceRules.some(r => r.original === orig)) {
                            replaceRules.push({ original: orig, replacement: repl });
                            localStorage.setItem(replaceKey, JSON.stringify(replaceRules));
                            renderReplaceRules();
                            applyTextReplacements();
                            prepareBlocks();
                            replaceForm.reset();
                        } else {
                            alert("Từ gốc này đã tồn tại!");
                        }
                    }
                });
            }

            renderReplaceRules();

            // Khởi động
            saveSettings(JSON.parse(localStorage.getItem(settingsKey) || "{}"));
            prepareBlocks(); // initTTSEngine() được gọi bên trong

            // Khởi tạo Mini Player (chỉ 1 lần)
            TTSMiniPlayer.init(TTSEngine, {
                chapterId:    chapterId,
                totalBlocks:  ttsBlocks.length,
                storyTitle:   @Json.Serialize(Model.Chapter.Truyen.TieuDe),
                chapterTitle: @Json.Serialize($"Chương {Model.Chapter.SoChuong}: {Model.Chapter.TieuDe}")
            });

            // Kiểm tra Smart Resume
            const resumeBlock = TTSMiniPlayer.checkResume();
            if (resumeBlock !== null) {
                const banner = document.getElementById('ttsResumeBanner');
                if (banner) {
                    banner.hidden = false;
                    const lbl = document.getElementById('resumeBlockLabel');
                    if (lbl) lbl.textContent = resumeBlock + 1;
                }
            }

            window.addEventListener("scroll", scheduleSaveReadingPosition, { passive: true });
            window.addEventListener("resize", scheduleSaveReadingPosition);
            window.addEventListener("beforeunload", () => {
                saveReadingPositionNow(true);
                TTSEngine.stop();
            });
        })();
    </script>
}
