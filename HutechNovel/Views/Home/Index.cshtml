                        <h4 class="story-info-popover__title">@truyen.TieuDe</h4>
                        <div class="story-info-popover__line"><strong>Tình trạng:</strong> @StatusText(truyen.TrangThai)</div>
                        <div class="story-info-popover__line"><strong>Tác giả:</strong> @(truyen.TacGia?.TenTacGia ?? "Đang cập nhật")</div>
                        <div class="story-info-popover__line"><strong>Lượt xem:</strong> @truyen.TongLuotXem.ToString("N0")</div>
                        <div class="story-info-popover__line"><strong>Lượt thích:</strong> @truyen.YeuThichs.Count.ToString("N0")</div>
                        <div class="story-info-popover__line"><strong>Lượt theo dõi:</strong> <span data-follow-count-for="@truyen.MaTruyen">@truyen.TheoDoiTruyens.Count.ToString("N0")</span></div>
                        @if (truyen.Thes.Any())
                        {
                            <div class="story-info-popover__tags">
                                @foreach (var tag in truyen.Thes.Take(8))
                                {
                                    <span class="story-info-popover__tag">@tag.TenThe</span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(truyen.MoTa))
                        {
                            <p class="story-info-popover__summary">@truyen.MoTa</p>
                        }
                    </div>
                    <div class="story-body p-3">
                        <h3 class="story-title text-truncate mb-1" title="@truyen.TieuDe">
                            <a asp-controller="Truyen" asp-action="ChiTiet" asp-route-id="@truyen.MaTruyen">@truyen.TieuDe</a>
                        </h3>
                        <div class="story-meta mt-3 d-flex flex-wrap gap-2">
                            <span class="meta-tag" style="font-size: 0.75rem; padding: 0.2rem 0.4rem;" title="Tổng số chương">
                                <i class="fas fa-list-ul me-1" style="color: var(--public-green);"></i>@truyen.TongSoChuong.ToString("N0") chương
                            </span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-box">Chưa có dữ liệu lượt đọc trong tuần này.</div>
    }
</section>

<section class="panel mb-4">
    <div class="section-kicker">Dựa trên gu đọc của bạn</div>
    <h2 class="section-title mb-4">Có thể bạn thích</h2>
    <div class="grid-4-cols">
        @foreach (var story in Model.SmartRecommendations.Take(4))
        {
            <article class="story-card story-card--hoverable">
                <a asp-controller="Truyen" asp-action="ChiTiet" asp-route-id="@story.MaTruyen" class="story-card__media">
                    <img class="story-cover w-100"
                         src="@(string.IsNullOrWhiteSpace(story.AnhBia) ? "https://static.sangtacvietcdn.xyz/img/bookcover256.jpg" : story.AnhBia)"
                         alt="@story.TieuDe"
                         style="aspect-ratio: 3/4; object-fit: cover;"
                         onerror="this.onerror=null; this.src='https://static.sangtacvietcdn.xyz/img/bookcover256.jpg';" />
                    <span class="story-update-badge">@UpdateTimeText(story.NgayCapNhat)</span>
                </a>
                <button class="quick-follow-btn @(currentUserId != null && story.TheoDoiTruyens.Any(x => x.MaNguoiDung == currentUserId) ? "is-active" : "")"
                        type="button"
                        data-story-id="@story.MaTruyen"
                        title="Theo dõi nhanh"
                        aria-label="Theo dõi nhanh @story.TieuDe">
                    <i class="@(currentUserId != null && story.TheoDoiTruyens.Any(x => x.MaNguoiDung == currentUserId) ? "fas" : "far") fa-bookmark"></i>
                </button>
                <div class="story-info-popover">
                    <h4 class="story-info-popover__title">@story.TieuDe</h4>
                    <div class="story-info-popover__line"><strong>Tình trạng:</strong> @StatusText(story.TrangThai)</div>
                    <div class="story-info-popover__line"><strong>Tác giả:</strong> @(story.TacGia?.TenTacGia ?? "Đang cập nhật")</div>
                    <div class="story-info-popover__line"><strong>Lượt xem:</strong> @story.TongLuotXem.ToString("N0")</div>
                    <div class="story-info-popover__line"><strong>Lượt thích:</strong> @story.YeuThichs.Count.ToString("N0")</div>
                    <div class="story-info-popover__line"><strong>Lượt theo dõi:</strong> <span data-follow-count-for="@story.MaTruyen">@story.TheoDoiTruyens.Count.ToString("N0")</span></div>
                    @if (story.Thes.Any())
                    {
                        <div class="story-info-popover__tags">
                            @foreach (var tag in story.Thes.Take(8))
                            {
                                <span class="story-info-popover__tag">@tag.TenThe</span>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(story.MoTa))
                    {
                        <p class="story-info-popover__summary">@story.MoTa</p>
                    }
                </div>
                <div class="story-body p-3">
                    <h3 class="story-title text-truncate mb-1" title="@story.TieuDe">
                        <a asp-controller="Truyen" asp-action="ChiTiet" asp-route-id="@story.MaTruyen">@story.TieuDe</a>
                    </h3>
                    <div class="story-meta mt-3 d-flex flex-wrap gap-2">
                        <span class="meta-tag" style="font-size: 0.75rem; padding: 0.2rem 0.4rem;" title="Tổng số chương">
                            <i class="fas fa-list-ul me-1" style="color: var(--public-green);"></i>@story.TongSoChuong.ToString("N0") chương
                        </span>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // === LOGIC TÌM KIẾM BÊN TRONG LỊCH SỬ THẬT ===
            const searchInput = document.getElementById('searchHistoryInput');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const keyword = e.target.value.toLowerCase().trim();
                    const items = document.querySelectorAll('.searchable-history');

                    items.forEach(item => {
                        const titleEl = item.querySelector('.history-title a');
                        if (titleEl) {
                            const title = titleEl.innerText.toLowerCase();
                            if (title.includes(keyword)) {
                                item.style.display = 'block';
                            } else {
                                item.style.display = 'none';
                            }
                        }
                    });
                });
            }

            // === LOGIC XÓA LỊCH SỬ BẰNG AJAX ===
            const deleteButtons = document.querySelectorAll('.btn-remove-history');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', async function () {
                    const idLichSu = this.getAttribute('data-id');

                    const form = new FormData();
                    form.append("maLichSu", idLichSu);

                    try {
                        const response = await fetch('/api/TuongTac/XoaLichSu', {
                            method: 'POST',
                            body: form
                        });

                        if (response.ok) {
                            const itemToHide = document.querySelector(`.history-item[data-id="${idLichSu}"]`);
                            if(itemToHide) {
                                itemToHide.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                                itemToHide.style.opacity = '0';
                                itemToHide.style.transform = 'translateX(20px)';
                                setTimeout(() => {
                                    itemToHide.remove();
                                    const historyContainer = document.getElementById('localHistoryList');
                                    if (historyContainer && historyContainer.querySelectorAll('.history-item').length === 0) {
                                        historyContainer.innerHTML = `
                                            <div class="empty-box p-3" style="min-height: 100px;">
                                                Chưa có lịch sử. Hãy đăng nhập và đọc truyện để hệ thống ghi nhớ!
                                            </div>`;
                                    }
                                }, 300);
                            }
                        } else {
                            alert('Có lỗi xảy ra, không thể xóa lịch sử.');
                        }
                    } catch (err) {
                        alert('Lỗi kết nối đến máy chủ.');
                    }
                });
            });

            document.querySelectorAll('.quick-follow-btn').forEach(button => {
                button.addEventListener('click', async function () {
                    const storyId = this.getAttribute('data-story-id');
                    const form = new FormData();
                    form.append('maTruyen', storyId);

                    this.disabled = true;
                    try {
                        const response = await fetch('/api/TuongTac/TheoDoi', {
                            method: 'POST',
                            body: form
                        });

                        if (response.status === 401) {
                            window.location.href = '/Identity/Account/Login';
                            return;
                        }

                        if (!response.ok) return;

                        const result = await response.json();
                        document.querySelectorAll(`.quick-follow-btn[data-story-id="${storyId}"]`).forEach(item => {
                            item.classList.toggle('is-active', result.active);
                            const icon = item.querySelector('i');
                            if (icon) {
                                icon.classList.toggle('fas', result.active);
                                icon.classList.toggle('far', !result.active);
                            }
                        });

                        document.querySelectorAll(`[data-follow-count-for="${storyId}"]`).forEach(item => {
                            item.textContent = Number(result.count).toLocaleString('vi-VN');
                        });
                    } catch (err) {
                        alert('Lỗi kết nối đến máy chủ.');
                    } finally {
                        this.disabled = false;
                    }
                });
            });
        });
    </script>
}
