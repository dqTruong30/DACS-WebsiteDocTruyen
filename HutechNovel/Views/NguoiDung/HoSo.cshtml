@model HutechNovel.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Hồ Sơ";
}

<section class="panel">
    <div class="section-kicker">Hồ sơ</div>
    <h1 class="page-title">@(!string.IsNullOrWhiteSpace(Model.User.HoTen) ? Model.User.HoTen : Model.User.UserName)</h1>
    <div class="muted mb-4">@Model.User.Email</div>

    <div class="stats-grid-4">
        <div class="stats-card">
            <div class="muted">Vé đẩy sách</div>
            <strong>@Model.User.VeDaySach</strong>
        </div>
        <div class="stats-card">
            <div class="muted">Truyện đã đọc</div>
            <strong>@Model.ReadStoryCount</strong>
        </div>
        <div class="stats-card">
            <div class="muted">Theo dõi</div>
            <strong>@Model.FollowingCount</strong>
        </div>
        <div class="stats-card">
            <div class="muted">Đọc sau</div>
            <strong>@Model.BookmarkCount</strong>
        </div>
    </div>
</section>
