    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<HutechNovel.Models.Truyen>
@{
    ViewData["Title"] = "Lọc Truyện Nâng Cao";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-filter text-success me-2"></i>Bộ Lọc Truyện</h2>

    <!-- Form Lọc -->
    <div class="card shadow-sm border-0 bg-body-tertiary mb-4">
        <div class="card-body">
            <form method="get" asp-action="LocTruyen">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="small fw-bold">Từ khóa</label>
                        <input type="text" name="keyword" class="form-control" value="@ViewBag.CurrentKeyword" placeholder="Tên truyện, tác giả...">
                    </div>
                    <div class="col-md-4">
                        <label class="small fw-bold">Tìm trong tóm tắt</label>
                        <input type="text" name="tomTat" class="form-control" value="@ViewBag.CurrentTomTat" placeholder="Nội dung cốt truyện...">
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold">Lượt xem từ</label>
                        <select name="viewMin" class="form-select">
                            <option value="0">Tất cả</option>
                            <option value="1000" selected="@(ViewBag.CurrentViewMin == 1000)">> 1,000</option>
                            <option value="10000" selected="@(ViewBag.CurrentViewMin == 10000)">> 10,000</option>
                            <option value="100000" selected="@(ViewBag.CurrentViewMin == 100000)">> 100,000</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold">Số chương từ</label>
                        <input type="number" name="chuongMin" class="form-control" value="@ViewBag.CurrentChuongMin" placeholder="VD: 50">
                    </div>
                    <div class="col-md-3">
                        <label class="small fw-bold">Sắp xếp theo</label>
                        <select name="sortBy" class="form-select">
                            <option value="new" selected="@(ViewBag.CurrentSort == "new")">Mới cập nhật</option>
                            <option value="viewTotal" selected="@(ViewBag.CurrentSort == "viewTotal")">Lượt xem nhiều nhất</option>
                            <option value="chuong" selected="@(ViewBag.CurrentSort == "chuong")">Nhiều chương nhất</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100 fw-bold">Lọc Ngay</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Thanh công cụ View Mode -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <span class="text-muted small">Tìm thấy <strong>@Model.Count()</strong> truyện trên trang này</span>
        <div class="btn-group shadow-sm">
            <button class="btn btn-outline-secondary active" id="btnGrid" onclick="toggleView('grid')">
                <i class="fas fa-th-large"></i> 4/Hàng
            </button>
            <button class="btn btn-outline-secondary" id="btnList" onclick="toggleView('list')">
                <i class="fas fa-list"></i> 1/Hàng
            </button>
        </div>
    </div>

    <!-- Danh sách truyện -->
    <div id="novelWrapper" class="row g-4 grid-mode">
        @foreach (var item in Model)
        {
            <div class="novel-item col-md-3">
                <a asp-action="ChiTiet" asp-route-id="@item.MaTruyen" class="text-decoration-none text-body">
                    <div class="card h-100 border-0 shadow-sm novel-card">
                        <div class="position-relative overflow-hidden">
                            <img src="@(string.IsNullOrWhiteSpace(item.AnhBia) ? "https://static.sangtacvietcdn.xyz/img/bookcover256.jpg" : item.AnhBia)"
                                 class="card-img-top novel-img"
                                 alt="@item.TieuDe"
                                 style="aspect-ratio: 3/4; object-fit: cover;"
                                 onerror="this.src='https://static.sangtacvietcdn.xyz/img/bookcover256.jpg';" />                            <div class="...">@item.TrangThai</div> <!-- Kiểm tra xem có cột TrangThai không -->
                        </div>
                        <div class="card-body">
                            <h6 class="...">@item.TieuDe</h6>
                            <p class="text-muted small mb-2"><i class="fas fa-pen-nib me-1"></i>@item.TacGia?.TenTacGia</p>

                            <!-- Icon Lượt xem thay cho chữ -->
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="small text-muted"><i class="far fa-eye me-1 text-primary"></i> @item.TongLuotXem</span>
                                <span class="small text-muted"><i class="fas fa-list-ul me-1 text-success"></i> @item.Chuongs.Count</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- Phân trang (Hiển thị 3 trang gần nhất) -->
    @if (totalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                @for (int i = Math.Max(1, currentPage - 1); i <= Math.Min(totalPages, currentPage + 1); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("LocTruyen", new { keyword = ViewBag.CurrentKeyword, tomTat = ViewBag.CurrentTomTat, viewMin = ViewBag.CurrentViewMin, chuongMin = ViewBag.CurrentChuongMin, sortBy = ViewBag.CurrentSort, page = i })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8em;
    }

    .novel-card {
        transition: transform 0.2s;
    }

        .novel-card:hover {
            transform: translateY(-5px);
        }

    /* Style cho chế độ List (1 truyện/hàng) */
    .list-mode .novel-item {
        width: 100%;
        flex: 0 0 100%;
    }

    .list-mode .novel-card {
        flex-direction: row;
    }

    .list-mode .novel-img {
        width: 150px;
        height: 200px !important;
    }
</style>

<script>
    function toggleView(mode) {
        const wrapper = document.getElementById('novelWrapper');
        const btnGrid = document.getElementById('btnGrid');
        const btnList = document.getElementById('btnList');

        if (mode === 'grid') {
            wrapper.classList.remove('list-mode');
            wrapper.classList.add('grid-mode');
            btnGrid.classList.add('active');
            btnList.classList.remove('active');
            document.querySelectorAll('.novel-item').forEach(el => el.classList.add('col-md-3'));
        } else {
            wrapper.classList.remove('grid-mode');
            wrapper.classList.add('list-mode');
            btnList.classList.add('active');
            btnGrid.classList.remove('active');
            document.querySelectorAll('.novel-item').forEach(el => el.classList.remove('col-md-3'));
        }
    }
</script>